---
import MainLayout from '@/layouts/MainLayout.astro';
import About from '@/components/home/About.astro';
---
<MainLayout title="About VIYUGAM 2K26">
  <section class="page-hero">
    <div class="container">
      <a href="/" class="back-link">← Back to Home</a>
      <span class="section-label">The Symposium</span>
      <h1>ENGINEERING<br />THE FUTURE.</h1>
      <p>A full-day celebration of engineering, innovation, and creativity at PPG Institute of Technology, Coimbatore.</p>
    </div>
  </section>
  <About />
</MainLayout>

<style lang="scss">
@use '../styles/variables' as *;
.page-hero { padding: 180px 0 90px; color: white; background: $black; }
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.12);
  border: 1px solid rgba(255, 101, 0, 0.35);
  color: #ff6500;
  font-family: $technical;
  font-weight: 700;
  font-size: 13.5px;
  letter-spacing: 0.06em;
  text-decoration: none;
  width: fit-content;
  transition: all 0.2s ease;

  &:hover {
    background: #ff6500;
    color: #ffffff;
    border-color: #ff6500;
    transform: translateX(-4px);
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}
.page-hero h1 { margin: 18px 0; font: clamp(4rem, 10vw, 8rem)/.86 $display; }
.page-hero p { max-width: 560px; color: rgba(255,255,255,.6); line-height: 1.7; }
</style>
