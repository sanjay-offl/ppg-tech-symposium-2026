---
import MainLayout from '@/layouts/MainLayout.astro';
import EventCard from '@/components/common/EventCard.astro';
import SymposiumGuidelines from '@/components/common/SymposiumGuidelines.astro';
import { departments } from '@/data/departments';
import { events } from '@/data/events';
import type { Department } from '@/types';

export async function getStaticPaths() {
  const paths = departments.map((department) => ({
    params: { slug: department.slug },
    props: { department }
  }));

  // Support aliases for backward compatibility
  const aliases: Record<string, string> = {
    'ai-data-science': 'ai-ds',
    'information-technology': 'it',
    'mechanical-engineering': 'mechanical',
    'electronics-communication': 'ece',
    'agricultural-engineering': 'agri'
  };

  for (const [alias, targetSlug] of Object.entries(aliases)) {
    const dept = departments.find((d) => d.slug === targetSlug);
    if (dept) {
      paths.push({
        params: { slug: alias },
        props: { department: dept }
      });
    }
  }

  return paths;
}

const { department } = Astro.props as { department: Department };

// Filter events for this department
const deptEvents = events.filter(
  (e) => e.departmentSlug === department.slug || e.department.toLowerCase() === department.name.toLowerCase()
);
const techEvents = deptEvents.filter((e) => e.category === 'Technical');
const nonTechEvents = deptEvents.filter((e) => e.category === 'Non-Technical');
---

<MainLayout title={`${department.abbr} (${department.name}) | VIYUGAM 2K26`} description={`Events and track details for ${department.name} at PPG Institute of Technology.`}>
  <section class="dept-hero">
    <div class="container">
      <a href="/departments" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        All Departments
      </a>

      <div class="dept-header-wrap">
        <div class="dept-badge">
          {department.image ? (
            <img src={department.image} alt={`${department.name} Logo`} class="dept-badge-logo" />
          ) : (
            <span>{department.abbr}</span>
          )}
        </div>

        <div class="dept-header-info">
          <span class="section-label">Department Track</span>
          <h1 class="dept-title">{department.name}</h1>

          <div class="dept-meta">
            <div class="coordinators-box">
              <strong>Student Coordinators</strong>
              <ul>
                {department.coordinators.map((coord) => <li>{coord}</li>)}
              </ul>
            </div>
            <div class="contact-box">
              <strong>Contact Email</strong>
              <a href={`mailto:${department.email}`}>{department.email}</a>
            </div>
            <div class="events-count-box">
              <strong>Total Events</strong>
              <span>{deptEvents.length} Events ({techEvents.length} Tech, {nonTechEvents.length} Non-Tech)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="dept-events-section">
    <div class="container">
      <!-- Technical Events -->
      <div class="events-group-block">
        <div class="group-header">
          <h2 class="group-title">TECHNICAL EVENTS</h2>
          <span class="count-badge">{techEvents.length} Events</span>
        </div>
        <div class="event-cards-grid">
          {techEvents.map((evt) => (
            <EventCard event={evt} />
          ))}
        </div>
      </div>

      <!-- Non-Technical Events -->
      <div class="events-group-block non-tech-block">
        <div class="group-header">
          <h2 class="group-title">NON-TECHNICAL EVENTS</h2>
          <span class="count-badge">{nonTechEvents.length} Events</span>
        </div>
        <div class="event-cards-grid">
          {nonTechEvents.map((evt) => (
            <EventCard event={evt} />
          ))}
        </div>
      </div>

      <!-- Single Overall Registration CTA -->
      <div class="dept-register-wrap">
        <div class="dept-register-box">
          <span class="cta-label">Single Pass · All Events Included</span>
          <h3 class="cta-title">Ready to Compete in {department.name}?</h3>
          <p class="cta-desc">Registration gives you full access to all technical & non-technical events, certificate, and complimentary lunch.</p>
          <a href={`/register?dept=${department.slug}`} class="overall-register-btn">Register for Events ➔</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section E: General Symposium Guidelines on every department page -->
  <SymposiumGuidelines />
</MainLayout>

<style lang="scss">
@use '../../styles/variables' as *;

.dept-hero {
  padding: 160px 0 60px;
  background: #000000; /* Pure deep black */
  color: #ffffff;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  padding: 8px 16px;
  border-radius: 999px;
  background: #181818;
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  width: fit-content;
  transition: all 0.2s ease;

  &:hover {
    background: $orange;
    color: #ffffff;
    border-color: $orange;
    transform: translateX(-3px);
  }
}

.dept-header-wrap {
  display: flex;
  align-items: flex-start;
  gap: 36px;
}

.dept-badge {
  display: grid;
  place-items: center;
  width: 110px;
  height: 110px;
  flex-shrink: 0;
  border-radius: 20px;
  background: #ffffff !important; /* Pure white background for all department logos */
  border: 2.5px solid $orange;
  color: $orange;
  font: 900 2.2rem/1 $technical;
  letter-spacing: 0.05em;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  overflow: hidden;
  padding: 12px;
}

.dept-badge-logo {
  width: 100%;
  height: 100%;
  max-width: 86px;
  max-height: 86px;
  object-fit: contain;
  display: block;
}

.dept-header-info {
  flex: 1;
}

.section-label {
  display: inline-block;
  font-family: $technical;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: $orange;
  margin-bottom: 6px;
}

.dept-title {
  margin: 0 0 20px;
  font: clamp(2.4rem, 5vw, 4rem)/1.05 $display;
  letter-spacing: 0.02em;
  color: #ffffff;
}

.dept-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 32px;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);

  strong {
    display: block;
    margin-bottom: 6px;
    color: $orange;
    font-family: $technical;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
    font-family: $body;
    font-size: 0.88rem;
    color: #f0f0f0;
    font-weight: 500;
  }

  a {
    color: #ffffff;
    font-family: $body;
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: $orange;
    }
  }

  span {
    font-family: $body;
    font-size: 0.88rem;
    color: #f0f0f0;
    font-weight: 500;
  }
}

.dept-events-section {
  padding: 80px 0 100px;
  background: #f5f5f7; /* Crisp white/light surface */
  color: #0a0a0a;
}

.events-group-block {
  margin-bottom: 64px;
}

.group-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28px;
  border-bottom: 1px solid rgba(10, 10, 10, 0.1);
  padding-bottom: 14px;
}

.group-title {
  margin: 0;
  font: 700 clamp(1.8rem, 3.5vw, 2.6rem)/1 $display;
  letter-spacing: 0.02em;
  color: #0a0a0a;
}

.count-badge {
  font-family: $technical;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: $orange;
}

.event-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}

.dept-register-wrap {
  margin-top: 50px;
  display: flex;
  justify-content: center;
}

.dept-register-box {
  width: 100%;
  max-width: 680px;
  padding: 44px 32px;
  border-radius: 20px;
  background: #141414; /* Pure neutral dark */
  border: 1px solid rgba(255, 101, 0, 0.4);
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.6);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-label {
  display: inline-block;
  padding: 5px 14px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.15);
  border: 1px solid rgba(255, 101, 0, 0.3);
  color: $orange;
  font-family: $technical;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.cta-title {
  margin: 0 0 12px;
  font: 700 clamp(1.8rem, 4vw, 2.6rem)/1.1 $display;
  letter-spacing: 0.02em;
  color: #ffffff;
}

.cta-desc {
  margin: 0 0 24px;
  max-width: 480px;
  color: #a3a3a3;
  font-family: $body;
  font-size: 0.92rem;
  line-height: 1.55;
}

.overall-register-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 36px;
  border-radius: 999px;
  background: $orange;
  color: white;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.92rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(255, 101, 0, 0.35);
  transition: all 0.25s ease;

  &:hover {
    background: #ff7a00;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(255, 101, 0, 0.5);
  }
}

@media (max-width: 768px) {
  .dept-hero {
    padding: 120px 0 40px;
  }
  .dept-header-wrap {
    flex-direction: column;
    gap: 20px;
  }
  .dept-badge {
    width: 80px;
    height: 80px;
    font-size: 1.8rem;
  }
  .dept-meta {
    gap: 20px;
  }
  .event-cards-grid {
    grid-template-columns: 1fr;
  }
  .dept-register-box {
    padding: 30px 20px;
  }
}
</style>
