---
import MainLayout from '@/layouts/MainLayout.astro';
import { departments } from '@/data/departments';
import { events } from '@/data/events';
import type { Department } from '@/types';

export async function getStaticPaths() {
  return departments.map((department) => ({
    params: { slug: department.slug },
    props: { department }
  }));
}

const { department } = Astro.props as { department: Department };

// Filter events for this specific department
const deptEvents = events.filter((e) => e.department.toLowerCase() === department.name.toLowerCase());
const techEvents = deptEvents.filter((e) => e.category === 'Technical');
const nonTechEvents = deptEvents.filter((e) => e.category === 'Non-Technical');
---

<MainLayout title={`${department.abbr} (${department.name}) | VIYUGAM 2K26`} description={`Events and track details for ${department.name} at PPG Institute of Technology.`}>
  <section class="dept-hero">
    <div class="container">
      <a href="/departments" class="back-link">← Back to Departments</a>
      <div class="dept-header-wrap">
        <div class="dept-badge">{department.abbr}</div>
        <div class="dept-header-info">
          <span class="section-label">Department Track</span>
          <h1 class="dept-title">{department.name}</h1>
          <div class="dept-meta">
            <div class="coordinators-box">
              <strong>Student Coordinators:</strong>
              <ul>
                {department.coordinators.map((coord) => <li>{coord}</li>)}
              </ul>
            </div>
            <div class="contact-box">
              <strong>Email:</strong>
              <a href={`mailto:${department.email}`}>{department.email}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="dept-events-section">
    <div class="container">
      <!-- Technical Events -->
      <div class="events-group-block">
        <h2 class="group-title">⚡ TECHNICAL EVENTS ({techEvents.length})</h2>
        <div class="event-cards-grid">
          {techEvents.map((evt) => (
            <article class="event-detail-card">
              <div class="event-badge tech-tag">TECHNICAL</div>
              <h3 class="event-name">{evt.name}</h3>
              <p class="event-desc">{evt.description}</p>
              <div class="event-specs">
                <span>📍 {evt.venue}</span>
                <span>⏰ {evt.time}</span>
                <span>👥 {evt.teamSize}</span>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Non-Technical Events -->
      <div class="events-group-block">
        <h2 class="group-title">🎮 NON-TECHNICAL EVENTS ({nonTechEvents.length})</h2>
        <div class="event-cards-grid">
          {nonTechEvents.map((evt) => (
            <article class="event-detail-card">
              <div class="event-badge non-tech-tag">NON-TECHNICAL</div>
              <h3 class="event-name">{evt.name}</h3>
              <p class="event-desc">{evt.description}</p>
              <div class="event-specs">
                <span>📍 {evt.venue}</span>
                <span>⏰ {evt.time}</span>
                <span>👥 {evt.teamSize}</span>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Single Overall Registration CTA -->
      <div class="dept-register-wrap">
        <div class="dept-register-box">
          <span class="cta-label">Single Pass · All Events Included</span>
          <h3 class="cta-title">Ready to Compete in {department.name}?</h3>
          <p class="cta-desc">₹250 pass gives you full access to all technical & non-technical events, certificate, and complimentary lunch.</p>
          <a href={`/register?dept=${department.slug}`} class="overall-register-btn">Register for Events ➔</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style lang="scss">
@use '../../styles/variables' as *;

.dept-hero {
  padding: 160px 0 60px;
  background: radial-gradient(circle at top center, rgba(255, 101, 0, 0.15), transparent 70%), #0d0d0f;
  color: white;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.back-link {
  display: inline-flex;
  align-items: center;
  margin-bottom: 32px;
  color: rgba(255, 255, 255, 0.6);
  font-family: $technical;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.06em;
  text-decoration: none;
  transition: color 0.2s ease, transform 0.2s ease;

  &:hover {
    color: $orange;
    transform: translateX(-4px);
  }
}

.dept-header-wrap {
  display: flex;
  align-items: flex-start;
  gap: 36px;
}

.dept-badge {
  display: grid;
  place-items: center;
  width: 110px;
  height: 110px;
  flex-shrink: 0;
  border-radius: 20px;
  background: linear-gradient(135deg, $orange 0%, #cc4e00 100%);
  color: white;
  font: 900 2.4rem/1 $technical;
  letter-spacing: 0.05em;
  box-shadow: 0 10px 30px rgba(255, 101, 0, 0.35);
}

.dept-header-info {
  flex: 1;
}

.dept-title {
  margin: 6px 0 20px;
  font: clamp(2.2rem, 5vw, 4rem)/1.05 $display;
  letter-spacing: 0.02em;
  color: white;
}

.dept-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 32px;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 14px;
  color: rgba(255, 255, 255, 0.85);

  strong {
    display: block;
    margin-bottom: 6px;
    color: $orange;
    font-family: $technical;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }

  a {
    color: white;
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: $orange;
    }
  }
}

.dept-events-section {
  padding: 70px 0 100px;
  background: #141416;
  color: white;
}

.events-group-block {
  margin-bottom: 56px;
}

.group-title {
  margin-bottom: 28px;
  font: 700 1.6rem/1 $technical;
  letter-spacing: 0.06em;
  color: white;
  display: flex;
  align-items: center;
  gap: 12px;

  &::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
  }
}

.event-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}

.event-detail-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 24px;
  background: #202024;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;

  &:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 101, 0, 0.5);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }
}

.event-badge {
  align-self: flex-start;
  padding: 4px 10px;
  border-radius: 999px;
  font: 700 10px/1 $technical;
  letter-spacing: 0.1em;
  margin-bottom: 14px;

  &.tech-tag {
    background: rgba(255, 101, 0, 0.15);
    color: $orange;
    border: 1px solid rgba(255, 101, 0, 0.3);
  }

  &.non-tech-tag {
    background: rgba(0, 180, 216, 0.15);
    color: #00b4d8;
    border: 1px solid rgba(0, 180, 216, 0.3);
  }
}

.event-name {
  margin: 0 0 10px;
  font: 700 1.35rem/1.2 $technical;
  letter-spacing: 0.02em;
  color: white;
}

.event-desc {
  margin: 0 0 20px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 13.5px;
  line-height: 1.5;
  flex: 1;
}

.event-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: auto;
  padding: 10px 14px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.25);
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
}

.dept-register-wrap {
  margin-top: 50px;
  display: flex;
  justify-content: center;
}

.dept-register-box {
  width: 100%;
  max-width: 640px;
  padding: 38px 28px;
  border-radius: 20px;
  background: linear-gradient(135deg, rgba(255, 101, 0, 0.14) 0%, rgba(26, 26, 30, 0.95) 100%);
  border: 1px solid rgba(255, 101, 0, 0.38);
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.4), 0 0 35px rgba(255, 101, 0, 0.18);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-label {
  display: inline-block;
  padding: 5px 14px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.2);
  color: $orange;
  font: 700 11px $technical;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.cta-title {
  margin: 0 0 10px;
  font: 700 2rem/1.1 $display;
  letter-spacing: 0.02em;
  color: white;
}

.cta-desc {
  margin: 0 0 24px;
  max-width: 480px;
  color: rgba(255, 255, 255, 0.75);
  font-size: 14px;
  line-height: 1.55;
}

.overall-register-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 36px;
  border-radius: 999px;
  background: linear-gradient(135deg, $orange 0%, #ff7a00 100%);
  color: white;
  font-family: $technical;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(255, 101, 0, 0.4);
  transition: transform 0.25s ease, box-shadow 0.25s ease;

  &:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 32px rgba(255, 101, 0, 0.6);
  }
}

@media (max-width: 640px) {
  .dept-hero {
    padding: 120px 0 40px;
  }
  .dept-header-wrap {
    flex-direction: column;
    gap: 16px;
  }
  .dept-badge {
    width: 70px;
    height: 70px;
    font-size: 1.6rem;
    border-radius: 14px;
  }
  .event-cards-grid {
    grid-template-columns: 1fr;
  }
  .dept-register-box {
    padding: 28px 20px;
  }
  .cta-title {
    font-size: 1.6rem;
  }
  .overall-register-btn {
    width: 100%;
    padding: 14px 20px;
    font-size: 14px;
  }
}
</style>
