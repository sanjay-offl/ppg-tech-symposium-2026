---
import MainLayout from '@/layouts/MainLayout.astro';
import DepartmentGrid from '@/components/departments/DepartmentGrid.astro';
import SymposiumGuidelines from '@/components/common/SymposiumGuidelines.astro';
---

<MainLayout title="Departments | VIYUGAM 2K26">
  <section class="page-heading">
    <div class="container">
      <span class="section-label">Eight Disciplines • 40+ Events</span>
      <h1>ALL DEPARTMENTS</h1>
      <p class="heading-sub">
        Explore specialized technical challenges, workshops, and non-technical competitions hosted across all 8 engineering disciplines at VIYUGAM 2K26.
      </p>
    </div>
  </section>

  <section class="content" id="dept-section">
    <!-- Moving Rays Background -->
    <div class="moving-rays-bg" aria-hidden="true">
      <div class="ray-layer ray-layer-1"></div>
      <div class="ray-layer ray-layer-2"></div>
      <div class="ray-layer ray-layer-3"></div>
      <div class="rays-ambient-glow"></div>
    </div>

    <div class="container">
      <div class="dept-header-box">
        <span class="section-label">Compete & Win</span>
        <h2 class="section-title">CHOOSE YOUR DEPARTMENT</h2>
      </div>
      <DepartmentGrid />
    </div>
  </section>

  <SymposiumGuidelines />
</MainLayout>

<script>
  function initRaysScroll() {
    const ray1 = document.querySelector('.ray-layer-1') as HTMLElement;
    const ray2 = document.querySelector('.ray-layer-2') as HTMLElement;
    const ray3 = document.querySelector('.ray-layer-3') as HTMLElement;
    const section = document.getElementById('dept-section');

    if (!section || !ray1 || !ray2 || !ray3) return;

    let ticking = false;

    function updateRays() {
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      // Calculate scroll progress relative to viewport (0 to 1)
      const totalScrollable = rect.height + windowHeight;
      const currentPos = windowHeight - rect.top;
      const progress = Math.max(0, Math.min(1, currentPos / totalScrollable));

      // Rotate ray layers based on scroll progress
      const rot1 = progress * 45;
      const rot2 = progress * -35;
      const rot3 = progress * 60;

      if (ray1) ray1.style.transform = `rotate(${rot1}deg) scale(1.2)`;
      if (ray2) ray2.style.transform = `rotate(${rot2}deg) scale(1.25)`;
      if (ray3) ray3.style.transform = `rotate(${rot3}deg) scale(1.15)`;

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateRays);
        ticking = true;
      }
    }, { passive: true });

    updateRays();
  }

  document.addEventListener('DOMContentLoaded', initRaysScroll);
  document.addEventListener('astro:page-load', initRaysScroll);
</script>

<style lang="scss">
@use '../../styles/variables' as *;

.page-heading {
  padding: 180px 0 70px;
  color: white;
  background: #000000;
  text-align: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);

  .section-label {
    display: inline-block;
    color: $orange;
    font-family: $technical;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  h1 {
    margin: 0 0 16px;
    font: clamp(3rem, 7vw, 5.5rem)/0.92 $display;
    letter-spacing: 0.02em;
    color: #ffffff;
  }

  .heading-sub {
    max-width: 680px;
    margin: 0 auto;
    font-family: $body;
    font-size: 1rem;
    line-height: 1.6;
    color: #a3a3a3;
  }
}

.content {
  position: relative;
  overflow: hidden;
  padding: 70px 0 100px;
  background: #f5f5f7;

  .container {
    position: relative;
    z-index: 2;
  }
}

/* === MOVING RAYS BACKGROUND === */
.moving-rays-bg {
  position: absolute;
  inset: -60% -30%;
  pointer-events: none;
  z-index: 1;
  opacity: 0.38; /* Low opacity as requested */
  overflow: hidden;

  .ray-layer {
    position: absolute;
    inset: -30%;
    transform-origin: 50% 30%;
    will-change: transform;
    transition: transform 0.12s cubic-bezier(0.1, 0.9, 0.2, 1);
  }

  .ray-layer-1 {
    background: repeating-conic-gradient(
      from 0deg at 50% 30%,
      rgba(255, 101, 0, 0.14) 0deg 8deg,
      transparent 8deg 22deg,
      rgba(255, 101, 0, 0.08) 22deg 32deg,
      transparent 32deg 45deg
    );
    mask-image: radial-gradient(circle at 50% 30%, black 15%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, black 15%, transparent 75%);
  }

  .ray-layer-2 {
    background: repeating-conic-gradient(
      from 15deg at 50% 30%,
      rgba(255, 140, 0, 0.09) 0deg 12deg,
      transparent 12deg 28deg,
      rgba(255, 80, 0, 0.06) 28deg 38deg,
      transparent 38deg 55deg
    );
    mask-image: radial-gradient(circle at 50% 30%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, black 20%, transparent 80%);
  }

  .ray-layer-3 {
    background: repeating-conic-gradient(
      from 30deg at 50% 30%,
      rgba(255, 165, 0, 0.11) 0deg 6deg,
      transparent 6deg 18deg,
      rgba(255, 101, 0, 0.05) 18deg 30deg,
      transparent 30deg 42deg
    );
    mask-image: radial-gradient(circle at 50% 30%, black 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, black 10%, transparent 70%);
  }

  .rays-ambient-glow {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 650px;
    height: 650px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 101, 0, 0.16) 0%, rgba(255, 101, 0, 0.03) 50%, transparent 75%);
    filter: blur(45px);
  }
}

.dept-header-box {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 44px;
  padding: 20px 48px;
  border-radius: 20px;
  background: #ffffff;
  border: 1px solid rgba(10, 10, 10, 0.08);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
  text-align: center;
  width: fit-content;
  max-width: calc(100% - 32px);

  .section-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: $technical;
    font-size: 0.74rem;
    font-weight: 700;
    color: $orange;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 8px 0 0;
    font: clamp(2.2rem, 5vw, 3.8rem)/0.95 $display;
    letter-spacing: 0.01em;
    color: #0a0a0a;
  }
}

@media (max-width: 640px) {
  .page-heading {
    padding: 130px 0 50px;

    .heading-sub {
      font-size: 0.9rem;
      padding: 0 16px;
    }
  }

  .content {
    padding: 38px 0 60px;
  }

  .dept-header-box {
    padding: 10px 20px;
    margin: 0 auto 24px;
    border-radius: 12px;

    .section-title {
      font-size: clamp(1.6rem, 5vw, 2.2rem);
    }
  }
}
</style>

