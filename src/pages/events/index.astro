---
import MainLayout from '@/layouts/MainLayout.astro';
import EventCard from '@/components/common/EventCard.astro';
import SymposiumGuidelines from '@/components/common/SymposiumGuidelines.astro';
import { events } from '@/data/events';
import { departments } from '@/data/departments';
---

<MainLayout title="All Events | VIYUGAM 2K26" description="Browse all 40+ technical and non-technical events across 8 departments at VIYUGAM 2K26.">
  <section class="events-hero">
    <div class="container">
      <span class="hero-label">8 Departments • 40+ Challenges</span>
      <h1 class="hero-title">ALL SYMPOSIUM EVENTS</h1>
      <p class="hero-lead">
        Compete in high-stakes reverse coding, CAD modeling, circuit forensics, AI spin-and-solve, eFootball tournaments, and paper presentations. One registration pass unlocks all events.
      </p>
    </div>
  </section>

  <section class="events-main-section">
    <div class="container">
      <!-- Filter and Search Controls -->
      <div class="controls-panel">
        <div class="search-box">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="event-search" placeholder="Search events by title, keyword, or concept..." aria-label="Search events" />
        </div>

        <div class="filter-groups">
          <div class="filter-group category-filters" role="group" aria-label="Filter by category">
            <button class="filter-btn active" data-category-filter="all">All Events ({events.length})</button>
            <button class="filter-btn" data-category-filter="Technical">Technical</button>
            <button class="filter-btn" data-category-filter="Non-Technical">Non-Technical</button>
          </div>

          <div class="filter-group dept-filters" role="group" aria-label="Filter by department">
            <button class="filter-btn dept-btn active" data-dept-filter="all">All Depts</button>
            {departments.map((dept) => (
              <button class="filter-btn dept-btn" data-dept-filter={dept.slug}>{dept.abbr}</button>
            ))}
          </div>
        </div>
      </div>

      <!-- Events Grid -->
      <div class="events-grid" id="events-container">
        {events.map((evt) => (
          <div
            class="event-grid-item"
            data-category={evt.category}
            data-dept={evt.departmentSlug}
            data-title={evt.name.toLowerCase()}
            data-concept={(evt.concept || evt.description || '').toLowerCase()}
          >
            <EventCard event={evt} showDepartment={true} />
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div class="no-results" id="no-results" hidden>
        <div class="no-results-box">
          <span class="no-results-icon">🔍</span>
          <h3>No matching events found</h3>
          <p>Try searching with a different keyword or resetting your category/department filters.</p>
          <button id="reset-filters" class="reset-btn">Reset All Filters</button>
        </div>
      </div>
    </div>
  </section>

  <SymposiumGuidelines />
</MainLayout>

<style lang="scss">
@use '../../styles/variables' as *;

.events-hero {
  padding: 170px 0 60px;
  background: #000000; /* Pure deep black */
  color: #ffffff;
  text-align: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);

  .hero-label {
    display: inline-block;
    color: $orange;
    font-family: $technical;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .hero-title {
    margin: 0 0 16px;
    font: clamp(3rem, 7vw, 5.5rem)/0.92 $display;
    letter-spacing: 0.02em;
    color: #ffffff;
  }

  .hero-lead {
    max-width: 720px;
    margin: 0 auto;
    font-family: $body;
    font-size: 1rem;
    line-height: 1.6;
    color: #a3a3a3;
  }
}

.events-main-section {
  padding: 60px 0 100px;
  background: #f5f5f7; /* Crisp white/light surface */
  min-height: 60vh;
}

.controls-panel {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 40px;
  padding: 24px;
  background: #ffffff; /* Clean white surface */
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-radius: 16px;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
}

.search-box {
  position: relative;
  width: 100%;

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #737373;
    pointer-events: none;
  }

  input {
    width: 100%;
    padding: 14px 16px 14px 46px;
    border-radius: 10px;
    background: #fafafa;
    border: 1px solid rgba(10, 10, 10, 0.12);
    color: #0a0a0a;
    font-family: $body;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;

    &::placeholder {
      color: #737373;
    }

    &:focus {
      border-color: $orange;
      background: #ffffff;
    }
  }
}

.filter-groups {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  align-items: center;
  justify-content: space-between;
}

.filter-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-btn {
  padding: 8px 14px;
  border-radius: 999px;
  background: #f5f5f7;
  border: 1px solid rgba(10, 10, 10, 0.1);
  color: #171717;
  font-family: $technical;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: #e5e5e5;
    color: #0a0a0a;
    border-color: rgba(10, 10, 10, 0.2);
  }

  &.active {
    background: $orange;
    color: #ffffff;
    border-color: $orange;
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}

.events-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 24px;
}

.event-grid-item {
  display: flex;
  flex-direction: column;

  &[hidden] {
    display: none !important;
  }
}

.no-results {
  padding: 60px 0;
  text-align: center;
}

.no-results-box {
  max-width: 460px;
  margin: 0 auto;
  padding: 36px 24px;
  background: #ffffff;
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);

  .no-results-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 12px;
  }

  h3 {
    margin: 0 0 8px;
    font-family: $display;
    font-size: 1.8rem;
    color: #0a0a0a;
    letter-spacing: 0.02em;
  }

  p {
    font-family: $body;
    font-size: 0.92rem;
    color: #1a1a1a;
    line-height: 1.55;
    margin: 0 0 20px;
  }
}

.reset-btn {
  padding: 10px 22px;
  border-radius: 999px;
  background: $orange;
  border: none;
  color: #ffffff;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background: #ff7a00;
  }
}

@media (max-width: 768px) {
  .events-hero {
    padding: 130px 0 40px;
  }
  .controls-panel {
    padding: 16px;
  }
  .events-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  const searchInput = document.getElementById('event-search') as HTMLInputElement | null;
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
  const deptBtns = document.querySelectorAll<HTMLButtonElement>('[data-dept-filter]');
  const eventCards = document.querySelectorAll<HTMLElement>('.event-grid-item');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters');

  let activeCategory = 'all';
  let activeDept = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;

    eventCards.forEach((card) => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardDept = card.getAttribute('data-dept') || '';
      const cardTitle = card.getAttribute('data-title') || '';
      const cardConcept = card.getAttribute('data-concept') || '';

      const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;
      const matchesDept = activeDept === 'all' || cardDept === activeDept;
      const matchesSearch = !searchQuery || cardTitle.includes(searchQuery) || cardConcept.includes(searchQuery);

      if (matchesCategory && matchesDept && matchesSearch) {
        card.removeAttribute('hidden');
        visibleCount++;
      } else {
        card.setAttribute('hidden', '');
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.removeAttribute('hidden');
      } else {
        noResults.setAttribute('hidden', '');
      }
    }
  }

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-category-filter') || 'all';
      applyFilters();
    });
  });

  deptBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      deptBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeDept = btn.getAttribute('data-dept-filter') || 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    applyFilters();
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'all';
    activeDept = 'all';

    categoryBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-category-filter') === 'all'));
    deptBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-dept-filter') === 'all'));

    applyFilters();
  });
</script>
