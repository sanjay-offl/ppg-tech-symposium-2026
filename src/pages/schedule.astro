---
import MainLayout from '@/layouts/MainLayout.astro';
---
<MainLayout title="Schedule | VIYUGAM 2K26">
  <section class="schedule">
    <div class="container">
      <a href="/" class="back-link">← Back to Home</a>
      <span class="section-label">25 September 2026</span>
      <h1>THE DAY<br />AT A GLANCE.</h1>
      <div class="timeline">
        <div><time>08:30</time><strong>Registration & Check-in</strong><p>Arrive at PPG Institute of Technology and collect your participant details.</p></div>
        <div><time>10:00</time><strong>Events Begin</strong><p>Technical and non-technical events across every department.</p></div>
        <div><time>13:00</time><strong>Lunch & Refreshments</strong><p>Lunch is included for all registered participants.</p></div>
        <div><time>16:00</time><strong>Valedictory & Prizes</strong><p>Celebrate the winners and collect participation certificates.</p></div>
      </div>
    </div>
  </section>
</MainLayout>

<style lang="scss">
@use '../styles/variables' as *;
.schedule { padding: 190px 0 120px; background: $surface; }
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.12);
  border: 1px solid rgba(255, 101, 0, 0.35);
  color: #ff6500;
  font-family: $technical;
  font-weight: 700;
  font-size: 13.5px;
  letter-spacing: 0.06em;
  text-decoration: none;
  width: fit-content;
  transition: all 0.2s ease;

  &:hover {
    background: #ff6500;
    color: #ffffff;
    border-color: #ff6500;
    transform: translateX(-4px);
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}
.schedule h1 { margin: 18px 0 65px; font: clamp(4rem, 10vw, 8rem)/.86 $display; }
.timeline { display: grid; max-width: 760px; gap: 0; }
.timeline > div { display: grid; grid-template-columns: 100px 1fr; gap: 20px; padding: 24px 0; border-top: 1px solid $line; }
.timeline time { color: $orange; font: 700 1.2rem $technical; }
.timeline strong { font: 1.4rem $technical; }
.timeline p { grid-column: 2; margin: 4px 0 0; color: $muted; font-size: .85rem; line-height: 1.6; }
@media (max-width: 520px) {
  .timeline > div { grid-template-columns: 70px 1fr; }
  .timeline p { grid-column: 1 / -1; }
}
</style>
