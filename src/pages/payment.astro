---
import MainLayout from '@/layouts/MainLayout.astro';
import { siteConfig } from '@/data/config';
---
<MainLayout title="Payment | VIYUGAM 2K26"><section class="payment"><div class="container"><span class="section-label">Pending verification</span><h1>COMPLETE<br />PAYMENT.</h1><div class="payment-panel"><h2>Registration summary</h2><p>VIYUGAM 2K26 · {siteConfig.date}</p><strong>₹{siteConfig.fee} <small>per head</small></strong><div class="qr-placeholder">Official UPI QR<br /><small>Configure QR asset before launch</small></div><form data-payment-form><label>Participant name<input name="participantName" required /></label><label>Email<input name="email" type="email" required /></label><label>Selected event<input name="selectedEvent" required /></label><label>Transaction reference / UTR<input name="transactionReference" required /></label><button class="button">Submit for verification</button><p data-payment-status role="status"></p></form></div></div></section></MainLayout>
<style lang="scss">@use '../styles/variables' as *;.payment { padding: 180px 0 110px; background: $surface; }.payment h1 { margin: 18px 0 35px; font: clamp(4rem, 10vw, 8rem)/.86 $display; }.payment-panel { max-width: 620px; padding: 32px; border-radius: 16px; background: white; }.payment-panel h2 { margin: 0 0 4px; font: 2rem $display; }.payment-panel p { color: $muted; }.payment-panel > strong { display: block; margin: 24px 0; color: $orange; font: 3rem $display; }.payment-panel > strong small { color: $muted; font: .8rem $body; }.qr-placeholder { display: grid; place-items: center; width: 160px; aspect-ratio: 1; margin-bottom: 28px; border: 1px dashed $orange; color: $orange; text-align: center; }.qr-placeholder small { color: $muted; font-size: .6rem; }.payment-panel form { display: grid; gap: 14px; }.payment-panel label { display: grid; gap: 6px; font-size: .75rem; font-weight: 700; }.payment-panel input { padding: 12px; border: 1px solid $line; border-radius: 6px; }.payment-panel button { width: fit-content; }.payment-panel [data-payment-status] { color: #16834a; font-size: .8rem; }</style>
<script>
import { submitPaymentReference } from '../services/payment';
const form = document.querySelector<HTMLFormElement>('[data-payment-form]'); form?.addEventListener('submit', async (event) => { event.preventDefault(); const status = form.querySelector<HTMLElement>('[data-payment-status]'); const button = form.querySelector<HTMLButtonElement>('button'); if (!status || !button) return; button.disabled = true; button.textContent = 'Submitting...'; try { await submitPaymentReference({ ...Object.fromEntries(new FormData(form)), amount: 250 } as never); status.textContent = 'Payment reference submitted. Status: Pending Verification.'; form.reset(); } catch { status.textContent = 'Payment endpoint is not configured yet. Please contact the coordinator.'; } finally { button.disabled = false; button.textContent = 'Submit for verification'; } });
</script>
