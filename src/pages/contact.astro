---
import MainLayout from '@/layouts/MainLayout.astro';
import { siteConfig } from '@/data/config';

const departmentCoordinators = [
  { name: 'AGRI', coordinators: [['Rakshana', '9876543210'], ['Saranya', '9876543211']] },
  { name: 'AI/DS', coordinators: [['Rahul Krishnith', '9876543212'], ['Sudhakar', '9876543213']] },
  { name: 'AI/ML', coordinators: [['Vyas', '9876543214'], ['Akash', '9876543215']] },
  { name: 'BME', coordinators: [['Krishna Kumar', '9876543216'], ['Ashwini', '9876543217']] },
  { name: 'CSE', coordinators: [['Nitheesh', '9876543218'], ['Dhanu Shree', '9876543219']] },
  { name: 'ECE', coordinators: [['Nakshatra', '9876543220'], ['Subagaanthan', '9876543221']] },
  { name: 'IT', coordinators: [['Deeksha', '9876543222'], ['Abhishek', '9876543223']] },
  { name: 'MECH', coordinators: [['Aravind Samy', '9876543224'], ['Thanaraj', '9876543225']] },
];
const mapQuery = encodeURIComponent(`${siteConfig.institution}, ${siteConfig.address}`);
---
<MainLayout title="Contact | VIYUGAM 2K26">
  <section class="contact-hero">
    <div class="container">
      <a href="/" class="back-link">← Back to Home</a>
      <span class="section-label">Get in touch</span>
      <div class="contact-hero-grid">
        <h1>CONTACT<br />THE TEAM.</h1>
        <p>Questions about events, registration, or the symposium? Reach out to the team and we will help you find the right answer.</p>
      </div>
    </div>
  </section>
  <section class="contact-page">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-details">
          <span class="section-label">Department coordinators</span>
          <div class="department-grid">
            {departmentCoordinators.map((department) => (
              <section class="department-card">
                <span class="dept-abbr-badge">{department.name}</span>
                <h2>{department.name}</h2>
                <ul>
                  {department.coordinators.map(([name, phone]) => (
                    <li><span>{name}</span><a href={`tel:${phone}`}>{phone}</a></li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
          <div class="venue">
            <span class="section-label">Venue</span>
            <div class="venue-content">
              <div>
                <p>{siteConfig.institution}<br />{siteConfig.address}</p>
              </div>
              <a
                class="button venue-maps-link"
                href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open in Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style lang="scss">
@use '../styles/variables' as *;
.contact-page { padding: 190px 0 120px; background: $surface; }
.contact-hero { padding: 150px 0 90px; background: #0a0a0a; color: #fff; }
.contact-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
.contact-hero-grid p { max-width: 430px; margin: 0 0 8px; color: #d1d1d1; line-height: 1.7; }
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.12);
  border: 1px solid rgba(255, 101, 0, 0.35);
  color: #ff6500;
  font-family: $technical;
  font-weight: 700;
  font-size: 13.5px;
  letter-spacing: 0.06em;
  text-decoration: none;
  width: fit-content;
  transition: all 0.2s ease;

  &:hover {
    background: #ff6500;
    color: #ffffff;
    border-color: #ff6500;
    transform: translateX(-4px);
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}
.contact-hero h1 {
  margin: 18px 0 0;
  font-family: $display;
  font-size: clamp(4rem, 10vw, 8rem);
  line-height: 0.86;
  color: #fff;
}
.contact-grid { display: grid; grid-template-columns: 1fr; }
.department-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 20px; }
.department-card {
  padding: 24px;
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-top: 4px solid $orange;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  transition: transform 0.25s ease, box-shadow 0.25s ease;

  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(255, 101, 0, 0.14);
  }
}
.dept-abbr-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60px;
  height: 32px;
  padding: 0 14px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.08);
  border: 1px solid rgba(255, 101, 0, 0.25);
  color: $orange;
  font: 700 0.95rem/1 $technical;
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}
.department-card h2 { margin: 0 0 14px; font: 700 1.25rem $technical; letter-spacing: 0.02em; }
.department-card ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
.department-card li { display: flex; flex-direction: column; gap: 3px; font-family: $body; }
.department-card li span { color: $black; font-weight: 600; font-size: .88rem; }
.department-card li a { width: fit-content; font-size: .82rem; font-weight: 600; color: $orange; text-decoration: none; &:hover { text-decoration: underline; } }
.contact-grid a { color: $orange; font-weight: 700; }
.venue {
  margin-top: 44px;
  padding: 28px;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid rgba(10, 10, 10, 0.08);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
}
.venue p { margin: 12px 0 0; color: $muted; line-height: 1.7; }
.venue-content { display: grid; grid-template-columns: minmax(220px, .8fr) 1.2fr; gap: 24px; align-items: start; }
.venue-maps-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 46px;
  padding: 0 26px;
  border-radius: 999px;
  background: $orange !important;
  color: #ffffff !important;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.92rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-decoration: none !important;
  box-shadow: 0 6px 20px rgba(255, 101, 0, 0.35);
  justify-self: start;
  margin-top: 16px;
  transition: all 0.25s ease;

  &:hover {
    background: #ff7a00 !important;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(255, 101, 0, 0.45);
  }
}
@media (max-width: 700px) {
  .contact-hero-grid { grid-template-columns: 1fr; gap: 30px; }
  .contact-hero-grid p { margin: 0; }
  .contact-grid { grid-template-columns: 1fr; gap: 30px; }
  .department-grid { grid-template-columns: 1fr; }
  .venue-content { grid-template-columns: 1fr; }
}
@media (min-width: 701px) and (max-width: 1000px) {
  .department-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
</style>
