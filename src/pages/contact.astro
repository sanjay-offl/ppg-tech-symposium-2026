---
import MainLayout from '@/layouts/MainLayout.astro';
import { siteConfig } from '@/data/config';
---
<MainLayout title="Contact | VIYUGAM 2K26"><section class="contact-page"><div class="container"><span class="section-label">Get in touch</span><h1>CONTACT<br />THE TEAM.</h1><div class="contact-grid"><div><h2>Event coordinator</h2><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><p>{siteConfig.institution}<br />{siteConfig.address}</p></div><form data-contact-form><label>Name<input required name="name" /></label><label>Email<input required type="email" name="email" /></label><label>Message<textarea required name="message" rows="5"></textarea></label><button class="button">Send message</button><p data-contact-status role="status"></p></form></div></div></section></MainLayout>
<style lang="scss">@use '../styles/variables' as *;.contact-page { padding: 190px 0 120px; background: $surface; }.contact-page h1 { margin: 18px 0 60px; font: clamp(4rem, 10vw, 8rem)/.86 $display; }.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }.contact-grid h2 { font: 2rem $display; }.contact-grid a { color: $orange; font-weight: 700; }.contact-grid p { color: $muted; line-height: 1.7; }.contact-grid form { display: grid; gap: 15px; }.contact-grid label { display: grid; gap: 6px; font-size: .75rem; font-weight: 700; }.contact-grid input, .contact-grid textarea { padding: 13px; border: 1px solid $line; border-radius: 7px; background: white; }.contact-grid button { width: fit-content; }.contact-grid [data-contact-status] { color: #16834a; }@media (max-width: 700px) {.contact-grid { grid-template-columns: 1fr; gap: 30px; }}</style>
<script>
import { submitToGoogleSheet } from '../services/googleSheets'; import { siteConfig } from '../data/config'; const form = document.querySelector<HTMLFormElement>('[data-contact-form]'); form?.addEventListener('submit', async (event) => { event.preventDefault(); const status = form.querySelector<HTMLElement>('[data-contact-status]'); const button = form.querySelector<HTMLButtonElement>('button'); if (!status || !button) return; button.disabled = true; button.textContent = 'Sending...'; try { await submitToGoogleSheet(Object.fromEntries(new FormData(form)), 'Contact Messages'); status.textContent = 'Message received. The coordinator will get back to you.'; form.reset(); } catch { status.textContent = `Please email ${siteConfig.email} directly.`; } finally { button.disabled = false; button.textContent = 'Send message'; } });
</script>
