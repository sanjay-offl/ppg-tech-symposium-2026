---
import MainLayout from '@/layouts/MainLayout.astro';
import { siteConfig } from '@/data/config';
---
<MainLayout title="Contact | VIYUGAM 2K26">
  <section class="contact-hero">
    <div class="container">
      <a href="/" class="back-link">← Back to Home</a>
      <span class="section-label">Get in touch</span>
      <div class="contact-hero-grid">
        <h1>CONTACT<br />THE TEAM.</h1>
        <p>Questions about events, registration, or the symposium? Reach out to the team and we will help you find the right answer.</p>
      </div>
    </div>
  </section>
  <section class="contact-page">
    <div class="container">
      <div class="contact-grid">
        <div>
          <h2>Event coordinator</h2>
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          <p>{siteConfig.institution}<br />{siteConfig.address}</p>
        </div>
        <form data-contact-form>
          <label>Name<input required name="name" /></label>
          <label>Email<input required type="email" name="email" /></label>
          <label>Message<textarea required name="message" rows="5"></textarea></label>
          <button class="button">Send message</button>
          <p data-contact-status role="status"></p>
        </form>
      </div>
    </div>
  </section>
</MainLayout>

<style lang="scss">
@use '../styles/variables' as *;
.contact-page { padding: 190px 0 120px; background: $surface; }
.contact-hero { padding: 150px 0 90px; background: #0a0a0a; color: #fff; }
.contact-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
.contact-hero-grid p { max-width: 430px; margin: 0 0 8px; color: #d1d1d1; line-height: 1.7; }
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.12);
  border: 1px solid rgba(255, 101, 0, 0.35);
  color: #ff6500;
  font-family: $technical;
  font-weight: 700;
  font-size: 13.5px;
  letter-spacing: 0.06em;
  text-decoration: none;
  width: fit-content;
  transition: all 0.2s ease;

  &:hover {
    background: #ff6500;
    color: #ffffff;
    border-color: #ff6500;
    transform: translateX(-4px);
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}
.contact-hero h1 { margin: 18px 0 0; font: clamp(4rem, 10vw, 8rem)/.86 $display; color: #fff; }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
.contact-grid h2 { font: 2rem $display; }
.contact-grid a { color: $orange; font-weight: 700; }
.contact-grid p { color: $muted; line-height: 1.7; }
.contact-grid form { display: grid; gap: 15px; }
.contact-grid label { display: grid; gap: 6px; font-size: .75rem; font-weight: 700; }
.contact-grid input, .contact-grid textarea { padding: 13px; border: 1px solid $line; border-radius: 7px; background: white; }
.contact-grid button { width: fit-content; }
.contact-grid [data-contact-status] { color: #16834a; }
@media (max-width: 700px) {
  .contact-hero-grid { grid-template-columns: 1fr; gap: 30px; }
  .contact-hero-grid p { margin: 0; }
  .contact-grid { grid-template-columns: 1fr; gap: 30px; }
}
</style>
<script>
import { submitToGoogleSheet } from '../services/googleSheets'; import { siteConfig } from '../data/config'; const form = document.querySelector<HTMLFormElement>('[data-contact-form]'); form?.addEventListener('submit', async (event) => { event.preventDefault(); const status = form.querySelector<HTMLElement>('[data-contact-status]'); const button = form.querySelector<HTMLButtonElement>('button'); if (!status || !button) return; button.disabled = true; button.textContent = 'Sending...'; try { await submitToGoogleSheet(Object.fromEntries(new FormData(form)), 'Contact Messages'); status.textContent = 'Message received. The coordinator will get back to you.'; form.reset(); } catch { status.textContent = `Please email ${siteConfig.email} directly.`; } finally { button.disabled = false; button.textContent = 'Send message'; } });
</script>
