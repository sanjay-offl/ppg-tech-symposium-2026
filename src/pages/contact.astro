---
import MainLayout from '@/layouts/MainLayout.astro';
import { siteConfig } from '@/data/config';
import { departments } from '@/data/departments';

const mapQuery = encodeURIComponent(`${siteConfig.institution}, ${siteConfig.address}`);
---
<MainLayout title="Contact | VIYUGAM 2K26">
  <section class="contact-hero">
    <div class="container">
      <a href="/" class="back-link">← Back to Home</a>
      <span class="section-label">Get in touch</span>
      <div class="contact-hero-grid">
        <h1>CONTACT<br />THE TEAM.</h1>
        <p>Questions about events, registration, or the symposium? Reach out to the team and we will help you find the right answer.</p>
      </div>
    </div>
  </section>
  <section class="contact-page">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-details">
          <span class="section-label">Department coordinators</span>
          <div class="department-grid">
            {departments.map((dept) => (
              <section class="department-card">
                <div class="dept-card-header">
                  {dept.image ? (
                    <div class="dept-logo-badge">
                      <img src={dept.image} alt={`${dept.name} Logo`} class="dept-logo-img" />
                    </div>
                  ) : (
                    <span class="dept-abbr-badge">{dept.abbr}</span>
                  )}
                </div>
                <h2>{dept.name}</h2>
                <div class="coord-subheading">STUDENT COORDINATORS</div>
                <ul>
                  {dept.coordinators.map((coordStr) => {
                    const parts = coordStr.split(' — ');
                    const name = parts[0];
                    const phone = parts[1] || '';
                    const cleanPhone = phone.replace(/\s+/g, '');
                    return (
                      <li>
                        <span>{name}</span>
                        {phone && <a href={`tel:${cleanPhone}`}>{phone}</a>}
                      </li>
                    );
                  })}
                </ul>
                {dept.staffCoordinators && dept.staffCoordinators.length > 0 && (
                  <div class="staff-coord-block">
                    <div class="coord-subheading staff-heading">STAFF COORDINATOR</div>
                    <ul>
                      {dept.staffCoordinators.map((coordStr) => {
                        const parts = coordStr.split(' — ');
                        const name = parts[0];
                        const phone = parts[1] || '';
                        const cleanPhone = phone.replace(/\s+/g, '');
                        return (
                          <li>
                            <span>{name}</span>
                            {phone && <a href={`tel:${cleanPhone}`}>{phone}</a>}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}
              </section>
            ))}
          </div>

          <!-- Overall Coordinators Section -->
          <div class="overall-coordinators-section">
            <div class="overall-header">
              <span class="section-label">Symposium Leadership</span>
              <h2 class="overall-section-title">OVERALL COORDINATORS</h2>
            </div>

            <div class="overall-cards-stack">
              <!-- Student Coordinators Card -->
              <article class="overall-card overall-card--student">
                <div class="overall-card__header">
                  <div class="overall-card__title-group">
                    <div class="overall-card__icon-badge">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                      </svg>
                    </div>
                    <div>
                      <span class="overall-card__badge">Student Leadership</span>
                      <h3 class="overall-card__heading">STUDENT COORDINATORS</h3>
                    </div>
                  </div>
                  <div class="overall-card__corner-accent" aria-hidden="true"></div>
                </div>

                <div class="overall-card__body">
                  <div class="overall-person-box">
                    <h4 class="overall-person__name">M.R. Tameema Naazmi</h4>
                    <span class="overall-person__role">President - Student Council</span>
                    <a href="tel:+919788455949" class="overall-person__phone">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                      </svg>
                      <span>+91 97884 55949</span>
                    </a>
                  </div>

                  <div class="overall-divider" aria-hidden="true"></div>

                  <div class="overall-person-box">
                    <h4 class="overall-person__name">A. Mohammed Jubair</h4>
                    <span class="overall-person__role">Secretary - Student Council</span>
                    <a href="tel:+918438433361" class="overall-person__phone">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                      </svg>
                      <span>+91 84384 33361</span>
                    </a>
                  </div>
                </div>
              </article>

              <!-- Faculty Coordinators Card -->
              <article class="overall-card overall-card--faculty">
                <div class="overall-card__header">
                  <div class="overall-card__title-group">
                    <div class="overall-card__icon-badge">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                      </svg>
                    </div>
                    <div>
                      <span class="overall-card__badge">Faculty Advisory</span>
                      <h3 class="overall-card__heading">FACULTY COORDINATORS</h3>
                    </div>
                  </div>
                  <div class="overall-card__corner-accent" aria-hidden="true"></div>
                </div>

                <div class="overall-card__body">
                  <div class="overall-person-box">
                    <h4 class="overall-person__name">Prof. Thamaraikannan. P</h4>
                    <span class="overall-person__role">Head of Department / AIDS</span>
                    <a href="tel:+919840858228" class="overall-person__phone">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                      </svg>
                      <span>+91 98408 58228</span>
                    </a>
                  </div>

                  <div class="overall-divider" aria-hidden="true"></div>

                  <div class="overall-person-box">
                    <h4 class="overall-person__name">Prof. Karthick Myilvahanan Jothivel</h4>
                    <span class="overall-person__role">Head of Department / CSE</span>
                    <a href="tel:+919003407729" class="overall-person__phone">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                      </svg>
                      <span>+91 90034 07729</span>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          </div>

          <div class="venue">
            <span class="section-label">Venue</span>
            <div class="venue-content">
              <div>
                <p>{siteConfig.institution}<br />{siteConfig.address}</p>
              </div>
              <a
                class="button venue-maps-link"
                href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open in Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style lang="scss">
@use '../styles/variables' as *;
.contact-page { padding: 190px 0 120px; background: $surface; }
.contact-hero { padding: 150px 0 90px; background: #0a0a0a; color: #fff; }
.contact-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
.contact-hero-grid p { max-width: 430px; margin: 0 0 8px; color: #d1d1d1; line-height: 1.7; }
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.12);
  border: 1px solid rgba(255, 101, 0, 0.35);
  color: #ff6500;
  font-family: $technical;
  font-weight: 700;
  font-size: 13.5px;
  letter-spacing: 0.06em;
  text-decoration: none;
  width: fit-content;
  transition: all 0.2s ease;

  &:hover {
    background: #ff6500;
    color: #ffffff;
    border-color: #ff6500;
    transform: translateX(-4px);
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}
.contact-hero h1 {
  margin: 18px 0 0;
  font-family: $display;
  font-size: clamp(4rem, 10vw, 8rem);
  line-height: 0.86;
  color: #fff;
}
.contact-grid { display: grid; grid-template-columns: 1fr; }
.department-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 20px; }
.department-card {
  padding: 24px;
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-top: 4px solid $orange;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  transition: transform 0.25s ease, box-shadow 0.25s ease;

  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(255, 101, 0, 0.14);
  }
}
.dept-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}
.dept-logo-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border-radius: 14px;
  padding: 6px;
  background: #ffffff !important;
  border: 1.5px solid rgba(10, 10, 10, 0.1);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);

  .dept-logo-img {
    width: 100%;
    height: 100%;
    max-width: 44px;
    max-height: 44px;
    object-fit: contain;
    display: block;
  }
}
.dept-abbr-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60px;
  height: 32px;
  padding: 0 14px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.08);
  border: 1px solid rgba(255, 101, 0, 0.25);
  color: $orange;
  font: 700 0.95rem/1 $technical;
  letter-spacing: 0.08em;
}
.department-card h2 {
  margin: 0 0 14px;
  padding-bottom: 10px;
  border-bottom: 2px solid rgba(255, 101, 0, 0.25);
  font: 700 1.25rem $technical;
  letter-spacing: 0.02em;
  transition: border-color 0.25s ease;
}
.department-card:hover h2 {
  border-color: $orange;
}
.coord-subheading {
  font-family: $technical;
  font-size: 0.72rem;
  font-weight: 700;
  color: $orange;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.staff-coord-block {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px dashed rgba(10, 10, 10, 0.12);
}
.staff-heading {
  color: #111827;
}
.department-card ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
.department-card li { display: flex; flex-direction: column; gap: 3px; font-family: $body; }
.department-card li span { color: $black; font-weight: 600; font-size: .88rem; }
.department-card li a { width: fit-content; font-size: .82rem; font-weight: 600; color: $orange; text-decoration: none; &:hover { text-decoration: underline; } }
.contact-grid a { color: $orange; font-weight: 700; }

/* Overall Coordinators Section */
.overall-coordinators-section {
  margin-top: 64px;
}

.overall-header {
  margin-bottom: 24px;
}

.overall-section-title {
  margin: 8px 0 0;
  font-family: $display;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  line-height: 0.95;
  letter-spacing: 0.02em;
  color: #0a0a0a;
}

.overall-cards-stack {
  display: flex;
  flex-direction: column;
  gap: 26px;
  margin-top: 20px;
}

.overall-card {
  position: relative;
  background: #ffffff;
  border-radius: 20px;
  padding: 28px 32px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.28s ease,
              border-color 0.28s ease;
  overflow: hidden;
}

/* Student Coordinators Card */
.overall-card--student {
  border: 1.5px solid rgba(255, 101, 0, 0.25);
  border-top: 5px solid $orange;

  .overall-card__icon-badge {
    background: rgba(255, 101, 0, 0.1);
    border: 1.5px solid rgba(255, 101, 0, 0.25);
    color: $orange;
  }

  .overall-card__badge {
    color: $orange;
    background: rgba(255, 101, 0, 0.08);
    border: 1px solid rgba(255, 101, 0, 0.2);
  }

  .overall-card__corner-accent {
    color: $orange;
  }

  .overall-person-box {
    background: #fafafc;
    border: 1px solid rgba(255, 101, 0, 0.14);

    &:hover {
      border-color: rgba(255, 101, 0, 0.35);
      background: #ffffff;
      box-shadow: 0 6px 20px rgba(255, 101, 0, 0.08);
    }
  }

  .overall-person__phone {
    background: rgba(255, 101, 0, 0.08);
    border: 1.2px solid rgba(255, 101, 0, 0.3);
    color: $orange;

    svg {
      color: $orange;
    }

    &:hover {
      background: $orange;
      color: #ffffff;
      border-color: $orange;
      box-shadow: 0 6px 18px rgba(255, 101, 0, 0.35);

      svg {
        color: #ffffff;
      }
    }
  }

  &:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 101, 0, 0.5);
    box-shadow: 0 18px 40px rgba(255, 101, 0, 0.14), 0 0 20px rgba(255, 101, 0, 0.06);
  }
}

/* Faculty Coordinators Card */
.overall-card--faculty {
  border: 1.5px solid rgba(15, 39, 74, 0.2);
  border-top: 5px solid #0f274a;

  .overall-card__icon-badge {
    background: rgba(15, 39, 74, 0.08);
    border: 1.5px solid rgba(15, 39, 74, 0.22);
    color: #0f274a;
  }

  .overall-card__badge {
    color: #0f274a;
    background: rgba(15, 39, 74, 0.07);
    border: 1px solid rgba(15, 39, 74, 0.18);
  }

  .overall-card__corner-accent {
    color: #0f274a;
  }

  .overall-person-box {
    background: #fafafc;
    border: 1px solid rgba(15, 39, 74, 0.12);

    &:hover {
      border-color: rgba(15, 39, 74, 0.3);
      background: #ffffff;
      box-shadow: 0 6px 20px rgba(15, 39, 74, 0.08);
    }
  }

  .overall-person__phone {
    background: rgba(15, 39, 74, 0.08);
    border: 1.2px solid rgba(15, 39, 74, 0.25);
    color: #0f274a;

    svg {
      color: #0f274a;
    }

    &:hover {
      background: #0f274a;
      color: #ffffff;
      border-color: #0f274a;
      box-shadow: 0 6px 18px rgba(15, 39, 74, 0.3);

      svg {
        color: #ffffff;
      }
    }
  }

  &:hover {
    transform: translateY(-3px);
    border-color: rgba(15, 39, 74, 0.4);
    box-shadow: 0 18px 40px rgba(15, 39, 74, 0.12), 0 0 20px rgba(15, 39, 74, 0.05);
  }
}

.overall-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(10, 10, 10, 0.08);
  margin-bottom: 22px;
}

.overall-card__title-group {
  display: flex;
  align-items: center;
  gap: 16px;
}

.overall-card__icon-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  flex-shrink: 0;
}

.overall-card__badge {
  display: inline-block;
  font-family: $technical;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 6px;
  margin-bottom: 4px;
}

.overall-card__heading {
  margin: 0;
  font-family: $technical;
  font-size: 1.32rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: #0a0a0a;
}

.overall-card__corner-accent {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 14px;
  height: 14px;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  opacity: 0.4;
}

.overall-card__body {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: stretch;
  gap: 20px;
}

.overall-person-box {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20px 22px;
  border-radius: 14px;
  transition: all 0.22s ease;
}

.overall-divider {
  width: 1px;
  align-self: stretch;
  background: rgba(10, 10, 10, 0.09);
}

.overall-person__name {
  margin: 0;
  font-family: $technical;
  font-size: 1.32rem;
  font-weight: 700;
  color: #0a0a0a;
  letter-spacing: 0.02em;
  line-height: 1.25;
}

.overall-person__role {
  font-family: $body;
  font-size: 0.88rem;
  font-weight: 500;
  color: $muted;
  margin-top: 4px;
  margin-bottom: 12px;
}

.overall-person__phone {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: 999px;
  width: fit-content;
  font-family: $technical;
  font-size: 0.92rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-decoration: none;
  transition: all 0.22s ease;

  svg {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  &:hover svg {
    transform: scale(1.15);
  }
}

.venue {
  margin-top: 56px;
  padding: 28px;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid rgba(10, 10, 10, 0.08);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
}
.venue p { margin: 12px 0 0; color: $muted; line-height: 1.7; }
.venue-content { display: grid; grid-template-columns: minmax(220px, .8fr) 1.2fr; gap: 24px; align-items: start; }
.venue-maps-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 46px;
  padding: 0 26px;
  border-radius: 999px;
  background: $orange !important;
  color: #ffffff !important;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.92rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-decoration: none !important;
  box-shadow: 0 6px 20px rgba(255, 101, 0, 0.35);
  justify-self: start;
  margin-top: 16px;
  transition: all 0.25s ease;

  &:hover {
    background: #ff7a00 !important;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(255, 101, 0, 0.45);
  }
}

@media (max-width: 768px) {
  .overall-coordinators-section {
    margin-top: 48px;
  }
  .overall-card {
    padding: 20px 16px;
    border-radius: 16px;
  }
  .overall-card__header {
    padding-bottom: 14px;
    margin-bottom: 16px;
  }
  .overall-card__icon-badge {
    width: 40px;
    height: 40px;
    border-radius: 10px;

    svg {
      width: 18px;
      height: 18px;
    }
  }
  .overall-card__heading {
    font-size: 1.15rem;
  }
  .overall-card__body {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .overall-divider {
    display: none;
  }
  .overall-person-box {
    padding: 16px;
  }
  .overall-person__name {
    font-size: 1.15rem;
  }
  .overall-person__phone {
    font-size: 0.88rem;
    padding: 7px 14px;
  }
}

@media (max-width: 700px) {
  .contact-hero-grid { grid-template-columns: 1fr; gap: 30px; }
