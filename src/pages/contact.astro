---
import MainLayout from '@/layouts/MainLayout.astro';
import { siteConfig } from '@/data/config';

const departmentCoordinators = [
  { name: 'AGRI', coordinators: [['Arun Kumar', '9876543210'], ['Priya Ramesh', '9876543211']] },
  { name: 'AI/ML', coordinators: [['Sanjeevi S', '9876543212'], ['Divya Shree', '9876543213']] },
  { name: 'BME', coordinators: [['Vigneshwaran S', '9876543214'], ['Yashwanth S K', '9876543215']] },
  { name: 'CSE', coordinators: [['Muralidharan K', '9876543216'], ['Sandhiya M', '9876543217']] },
  { name: 'ECE', coordinators: [['Karthik Raja', '9876543218'], ['Meenakshi S', '9876543219']] },
  { name: 'IT', coordinators: [['Arjun Prasath', '9876543220'], ['Kavya Lakshmi', '9876543221']] },
  { name: 'MECH', coordinators: [['Naveen Kumar', '9876543222'], ['Swetha R', '9876543223']] },
];
const mapQuery = encodeURIComponent(`${siteConfig.institution}, ${siteConfig.address}`);
---
<MainLayout title="Contact | VIYUGAM 2K26">
  <section class="contact-hero">
    <div class="container">
      <a href="/" class="back-link">← Back to Home</a>
      <span class="section-label">Get in touch</span>
      <div class="contact-hero-grid">
        <h1>CONTACT<br />THE TEAM.</h1>
        <p>Questions about events, registration, or the symposium? Reach out to the team and we will help you find the right answer.</p>
      </div>
    </div>
  </section>
  <section class="contact-page">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-details">
          <span class="section-label">Department coordinators</span>
          <div class="department-grid">
            {departmentCoordinators.map((department) => (
              <section class="department-card">
                <img class="department-card-image" src={`https://placehold.co/400x250/0a0a0a/ff6500?text=${department.name}`} alt={`${department.name} department placeholder`} loading="lazy" />
                <h2>{department.name}</h2>
                <ul>
                  {department.coordinators.map(([name, phone]) => (
                    <li><span>{name}</span><a href={`tel:${phone}`}>{phone}</a></li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
          <div class="venue">
            <span class="section-label">Venue</span>
            <div class="venue-content">
              <div>
                <p>{siteConfig.institution}<br />{siteConfig.address}</p>
              </div>
              <a
                class="button venue-maps-link"
                href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open in Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style lang="scss">
@use '../styles/variables' as *;
.contact-page { padding: 190px 0 120px; background: $surface; }
.contact-hero { padding: 150px 0 90px; background: #0a0a0a; color: #fff; }
.contact-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
.contact-hero-grid p { max-width: 430px; margin: 0 0 8px; color: #d1d1d1; line-height: 1.7; }
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.12);
  border: 1px solid rgba(255, 101, 0, 0.35);
  color: #ff6500;
  font-family: $technical;
  font-weight: 700;
  font-size: 13.5px;
  letter-spacing: 0.06em;
  text-decoration: none;
  width: fit-content;
  transition: all 0.2s ease;

  &:hover {
    background: #ff6500;
    color: #ffffff;
    border-color: #ff6500;
    transform: translateX(-4px);
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}
.contact-hero h1 {
  margin: 18px 0 0;
  font-family: $display;
  font-size: clamp(4rem, 10vw, 8rem);
  line-height: 0.86;
  color: #fff;
}
.contact-grid { display: grid; grid-template-columns: 1fr; }
.department-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
.department-card { padding: 0 18px 18px; border: 1px solid $line; border-radius: 7px; background: #fff; overflow: hidden; }
.department-card-image { display: block; width: calc(100% + 36px); aspect-ratio: 8 / 5; margin: 0 -18px 18px; object-fit: cover; }
.department-card h2 { margin: 0 0 12px; font: 1.5rem $display; }
.department-card ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
.department-card li { display: grid; gap: 2px; font-size: .9rem; }
.department-card li a { width: fit-content; font-size: .82rem; font-weight: 500; }
.contact-grid a { color: $orange; font-weight: 700; }
.venue { margin-top: 34px; }
.venue p { margin: 12px 0 0; color: $muted; line-height: 1.7; }
.venue-content { display: grid; grid-template-columns: minmax(220px, .8fr) 1.2fr; gap: 24px; align-items: start; }
.venue-maps-link { justify-self: start; margin-top: 12px; }
@media (max-width: 700px) {
  .contact-hero-grid { grid-template-columns: 1fr; gap: 30px; }
  .contact-hero-grid p { margin: 0; }
  .contact-grid { grid-template-columns: 1fr; gap: 30px; }
  .department-grid { grid-template-columns: 1fr; }
  .venue-content { grid-template-columns: 1fr; }
}
@media (min-width: 701px) and (max-width: 1000px) {
  .department-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
</style>
