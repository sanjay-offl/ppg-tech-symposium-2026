---
import { siteConfig } from '@/data/config';
import CountdownTimer from './CountdownTimer.astro';
import HeroSlideshow from './HeroSlideshow.astro';
---
<section class="hero" id="home">
  <!-- Animated background blobs (decorative only) -->
  <div class="blob blob--1" aria-hidden="true"></div>
  <div class="blob blob--2" aria-hidden="true"></div>

  <div class="hero-container">
    <!-- LEFT: Department Illustration Carousel -->
    <div class="hero-visual">
      <HeroSlideshow showLabel={false} />
    </div>

    <!-- RIGHT: Symposium Content -->
    <div class="hero-content">
      <p class="eyebrow anim-fadeinup" style="--anim-delay:0ms">National Level Technical Symposium</p>
      <div class="hero-title anim-fadeinup" style="--anim-delay:150ms">
        <h1>VIYU<span>GAM</span></h1>
        <div class="year">2K26</div>
      </div>
      <div class="anim-fadeinup" style="--anim-delay:350ms">
        <CountdownTimer />
      </div>
      <div class="event-info anim-fadeinup" style="--anim-delay:500ms">
        <p class="date">{siteConfig.date.toUpperCase()}</p>
        <p class="meta">{siteConfig.institution}, {siteConfig.location}<br />40+ Events · 8 Departments · Cash Prizes</p>
      </div>
      <div class="hero-actions anim-fadeinup" style="--anim-delay:650ms">
        <a class="button" href="/register" id="hero-register-btn">Register Now</a>
        <a class="button button--ghost" href="/departments" id="hero-explore-btn">
          Explore Events <span class="arrow-icon" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-line" aria-hidden="true"></div>
</section>

<style lang="scss">
@use '../../styles/variables' as *;

/* ═══════════════════════════════════════════════
   KEYFRAMES
   ═══════════════════════════════════════════════ */

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-32px); }
  to   { opacity: 1; transform: translateX(0); }
}

@keyframes float {
  from { transform: translate(0, 0); }
  to   { transform: translate(18px, 12px); }
}

.anim-fadeinup {
  opacity: 0;
  animation: fadeInUp 520ms cubic-bezier(0.22, 1, 0.36, 1) var(--anim-delay, 0ms) both;
}

/* ═══════════════════════════════════════════════
   BACKGROUND BLOBS
   ═══════════════════════════════════════════════ */

.blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.blob--1 {
  width: 380px;
  height: 380px;
  top: 0;
  left: -60px;
  background: radial-gradient(circle, rgba(249,115,22,0.07) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite alternate;
}

.blob--2 {
  width: 280px;
  height: 280px;
  bottom: 0;
  right: -40px;
  background: radial-gradient(circle, rgba(249,115,22,0.045) 0%, transparent 70%);
  animation: float 11s ease-in-out infinite alternate-reverse;
}

/* ═══════════════════════════════════════════════
   HERO SECTION
   — starts immediately after <main padding-top>
   — main already has padding-top: var(--navbar-height)
   ═══════════════════════════════════════════════ */

.hero {
  position: relative;
  isolation: isolate;
  /* Fill the viewport below the navbar */
  min-height: calc(100svh - var(--navbar-height));
  /* Comfortable internal breathing room — NOT large top padding */
  padding: 2rem 0 3rem;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #ffffff;
  margin-bottom: 0;   /* no negative-margin hacks into next section */
}

/* ═══════════════════════════════════════════════
   HERO GRID CONTAINER
   — one 2-col grid controlling both sides
   ═══════════════════════════════════════════════ */

.hero-container {
  position: relative;
  z-index: 2;
  width: min(100% - 3rem, 1280px);
  margin-inline: auto;
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 5rem);
}

/* ═══════════════════════════════════════════════
   LEFT — DEPARTMENT ILLUSTRATION
   ═══════════════════════════════════════════════ */

.hero-visual {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;        /* prevent grid blowout */
  /* Use 'backwards' not 'both' — 'both' keeps opacity:0 before start */
  animation: slideInLeft 680ms cubic-bezier(0.22, 1, 0.36, 1) 80ms backwards;
}

/* ═══════════════════════════════════════════════
   RIGHT — SYMPOSIUM CONTENT
   ═══════════════════════════════════════════════ */

.hero-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 0;             /* controlled by individual element margins below */
  min-width: 0;
  /* Zero out any inherited margin that could push this column down */
  margin: 0;
  padding: 0;

  > *:first-child { margin-top: 0 !important; }
}

/* ═══════════════════════════════════════════════
   EYEBROW LABEL
   ═══════════════════════════════════════════════ */

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 0.6rem;
  color: $orange;
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;

  &::before {
    content: '';
    width: 24px;
    height: 2px;
    background: $orange;
    flex-shrink: 0;
  }
}

/* ═══════════════════════════════════════════════
   TITLE BLOCK — VIYUGAM + 2K26 as one unit
   ═══════════════════════════════════════════════ */

.hero-title {
  margin: 0 0 0;
  line-height: 1;
}

.hero-title h1 {
  margin: 0;
  font: clamp(4.2rem, 8vw, 7.5rem) / 0.88 $display;
  letter-spacing: .01em;

  span { color: $orange; }
}

.year {
  margin-top: 0.1em;
  color: $orange;
  font: clamp(2.2rem, 4vw, 3.6rem) / 1 $display;
  letter-spacing: .08em;
  font-weight: 700;
}

/* ═══════════════════════════════════════════════
   EVENT INFO (date + meta)
   ═══════════════════════════════════════════════ */

.event-info {
  margin-top: 1.1rem;
}

.date {
  margin: 0 0 0.35rem;
  font: 700 1.1rem $technical;
  letter-spacing: .07em;
}

.meta {
  margin: 0;
  color: $muted;
  font-size: .84rem;
  line-height: 1.65;
}

/* ═══════════════════════════════════════════════
   CTA BUTTONS
   ═══════════════════════════════════════════════ */

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-top: 1.5rem;
  /* Never push to bottom of viewport */
}

/* Arrow icon on ghost button */
.arrow-icon {
  display: inline-block;
  transition: transform 0.2s ease;
}

.button--ghost:hover .arrow-icon {
  transform: translateX(4px);
}

/* ═══════════════════════════════════════════════
   BOTTOM ACCENT LINE
   ═══════════════════════════════════════════════ */

.hero-line {
  position: absolute;
  z-index: 3;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, $orange, rgba(255, 101, 0, 0.15) 60%, transparent);
}

/* ═══════════════════════════════════════════════
   RESPONSIVE — 1024px TABLET (stacked)
   ═══════════════════════════════════════════════ */

@media (max-width: 1024px) {
  .hero-container {
    grid-template-columns: 1fr;
    gap: 2rem;
    width: min(100% - 2.5rem, 680px);
  }

  .hero-visual {
    order: 1;

    :global(.hero-slideshow) {
      width: min(100%, 400px);
    }

    :global(.slides-viewport) {
      max-height: min(55vh, 480px);
    }

    :global(.slide-img) {
      max-height: min(55vh, 480px);
    }
  }

  .hero-content {
    order: 2;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    justify-content: center;
  }

  .hero-actions {
    justify-content: center;
  }
}

/* ═══════════════════════════════════════════════
   RESPONSIVE — 768px MOBILE
   ═══════════════════════════════════════════════ */

@media (max-width: 768px) {
  :root {
    /* Pill navbar is smaller on mobile: top 12px + height 50px + gap 16px */
    --navbar-height: 78px;
  }

  .hero {
    min-height: auto;
    padding: 1.5rem 0 2.5rem;
  }

  .hero-container {
    width: min(100% - 2rem, 560px);
    gap: 1.75rem;
  }

  .hero-visual {
    :global(.hero-slideshow) {
      width: min(100%, 340px);
    }

    :global(.slides-viewport) {
      max-height: none;
    }

    :global(.slide-img) {
      max-height: none;
    }
  }
}

/* ═══════════════════════════════════════════════
   RESPONSIVE — 375px SMALL MOBILE
   ═══════════════════════════════════════════════ */

@media (max-width: 430px) {
  .hero-title h1 {
    font-size: clamp(3.5rem, 12vw, 4.5rem);
  }

  .year {
    font-size: clamp(1.9rem, 7vw, 2.4rem);
  }
}

/* ═══════════════════════════════════════════════
   REDUCED MOTION
   ═══════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .anim-fadeinup,
  .hero-visual,
  .blob { animation: none !important; }
}
</style>
