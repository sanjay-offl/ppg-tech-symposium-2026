---
import { siteConfig } from '@/data/config';
import CountdownTimer from './CountdownTimer.astro';
---
<section class="hero" id="home">
  <div class="hero-car">
    <img src="/images/hero-car.png" alt="Orange and black Formula-style race car" fetchpriority="high" />
  </div>
  <div class="hero-content container">
    <p class="eyebrow">National Level Technical Symposium</p>
    <h1>VIYU<span>GAM</span></h1>
    <div class="year">2K26</div>
    <CountdownTimer />
    <p class="date">{siteConfig.date.toUpperCase()}</p>
    <p class="meta">{siteConfig.institution}, {siteConfig.location}<br />40+ Events · 8 Departments · Cash Prizes</p>
    <div class="hero-actions">
      <a class="button" href="/register">Register Now</a>
      <a class="button button--ghost" href="/departments">Explore Departments & Events <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="hero-line" aria-hidden="true"></div>
</section>

<style lang="scss">
@use '../../styles/variables' as *;

.hero {
  position: relative;
  min-height: min(880px, 100vh);
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #ffffff;
}

.hero-content {
  position: relative;
  z-index: 2;
  margin-left: auto;
  padding: 110px 3vw 64px 48%;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  color: $orange;
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;

  &::before {
    content: '';
    width: 26px;
    height: 2px;
    background: $orange;
  }
}

.hero h1 {
  margin: 16px 0 0;
  font: clamp(6rem, 12vw, 10rem)/.82 $display;
  letter-spacing: .01em;

  span {
    color: $orange;
  }
}

.year {
  margin: 14px 0 32px;
  color: rgba(10, 10, 10, .11);
  font: clamp(3rem, 5vw, 5rem) $display;
  letter-spacing: .08em;
}

.date {
  margin: 0 0 5px;
  font: 700 1.25rem $technical;
  letter-spacing: .08em;
}

.meta {
  color: $muted;
  font-size: .85rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 30px;
}

.hero-car {
  position: absolute;
  z-index: 1;
  bottom: -2%;
  left: -2%;
  width: clamp(540px, 52vw, 860px);
  pointer-events: none;

  img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.18));
  }
}

.hero-line {
  position: absolute;
  z-index: 3;
  bottom: 0;
  width: 70%;
  height: 3px;
  background: linear-gradient(90deg, $orange, transparent);
}

@media (max-width: 760px) {
  .hero {
    min-height: auto;
    display: flex;
    flex-direction: column;
    padding-top: 60px;
  }

  .hero-car {
    position: relative;
    left: 0;
    bottom: auto;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    order: 0;
  }

  .hero-content {
    width: 100%;
    padding: 20px 16px 64px;
    text-align: center;
  }

  .eyebrow {
    justify-content: center;
  }

  .hero-actions {
    justify-content: center;
  }

  .hero-line {
    width: 100%;
  }
}
</style>
