---
import { siteConfig } from '@/data/config';
import CountdownTimer from './CountdownTimer.astro';
---
<section class="hero" id="home"><div class="hero-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div><div class="hero-car"><img src="/images/hero-car.png" alt="Orange and black Formula-style race car" fetchpriority="high" /></div><div class="hero-content container"><p class="eyebrow">National Level Technical Symposium</p><h1>VIYU<span>GAM</span></h1><div class="year">2K26</div><CountdownTimer /><p class="date">{siteConfig.date.toUpperCase()}</p><p class="meta">{siteConfig.institution}, {siteConfig.location}<br />35+ Events · 7 Departments · ₹250 per head</p><div class="hero-actions"><a class="button" href="/register">Register Now</a><a class="button button--ghost" href="/events">Explore Events <span aria-hidden="true">→</span></a></div></div><div class="hero-line" aria-hidden="true"></div></section>
<style lang="scss">
@use '../../styles/variables' as *;
.hero { position: relative; min-height: min(850px, 100vh); display: grid; align-items: center; overflow: hidden; background: #fff; }.hero-content { position: relative; z-index: 2; margin-left: auto; padding: 120px 3vw 64px 50%; }.eyebrow { display: flex; align-items: center; gap: 10px; color: $orange; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }.eyebrow::before { content: ''; width: 26px; height: 2px; background: $orange; }.hero h1 { margin: 16px 0 0; font: clamp(6rem, 12vw, 10rem)/.82 $display; letter-spacing: .01em; }.hero h1 span { color: $orange; }.year { margin: 14px 0 32px; color: rgba(10,10,10,.11); font: clamp(3rem, 5vw, 5rem) $display; letter-spacing: .08em; }.date { margin: 0 0 5px; font: 700 1.25rem $technical; letter-spacing: .08em; }.meta { color: $muted; font-size: .85rem; line-height: 1.7; }.hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }.hero-car { position: absolute; z-index: 1; bottom: -3%; left: -8%; width: 64%; }.hero-car img { width: 100%; display: block; filter: drop-shadow(0 30px 60px rgba(0,0,0,.16)); }.hero-line { position: absolute; z-index: 3; bottom: 0; width: 70%; height: 3px; background: linear-gradient(90deg, $orange, transparent); }.hero-lines { position: absolute; inset: 0; opacity: .22; pointer-events: none; }.hero-lines i { position: absolute; left: 0; width: 55%; height: 1px; background: linear-gradient(90deg, transparent, $orange, transparent); transform: rotate(-12deg); }.hero-lines i:nth-child(1) { top: 28%; }.hero-lines i:nth-child(2) { top: 42%; width: 40%; }.hero-lines i:nth-child(3) { top: 58%; width: 60%; }.hero-lines i:nth-child(4) { top: 72%; width: 35%; }
@media (max-width: 760px) { .hero { min-height: auto; display: flex; flex-direction: column; padding-top: 66px; }.hero-car { position: relative; left: -8%; bottom: auto; width: 112%; order: 0; }.hero-content { width: 100%; padding: 26px 16px 64px; text-align: center; }.eyebrow { justify-content: center; }.hero-actions { justify-content: center; }.hero-line { width: 100%; } }
</style>
