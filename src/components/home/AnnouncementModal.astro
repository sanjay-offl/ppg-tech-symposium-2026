---
/* AnnouncementModal.astro - Date Postponement Announcement Modal */
---

<div id="announcement-modal" class="announcement-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Symposium Date Postponement Announcement">
  <div class="announcement-modal__overlay" data-modal-close></div>
  <div class="announcement-modal__dialog">
    <button type="button" class="announcement-modal__close" data-modal-close aria-label="Close Announcement">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="announcement-modal__content">
      <img
        src="/images/announcement.jpg"
        alt="VIYUGAM 2K26 Important Announcement: Symposium Postponed from 25th September 2026 to 15th October 2026. All other details remain the same."
        class="announcement-modal__img"
        width="1024"
        height="1024"
        loading="eager"
      />
    </div>
  </div>
</div>

<style lang="scss">
@use '../../styles/variables' as *;

.announcement-modal {
  position: fixed;
  inset: 0;
  z-index: 99998;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;

  &.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
}

.announcement-modal__overlay {
  position: absolute;
  inset: 0;
  background: rgba(8, 8, 12, 0.82);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  cursor: pointer;
}

.announcement-modal__dialog {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 490px;
  border-radius: 28px;
  background: transparent;
  box-shadow: 0 25px 65px -10px rgba(0, 0, 0, 0.65), 0 0 45px rgba(255, 101, 0, 0.28);
  transform: scale(0.88) translateY(12px);
  transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.35s ease;
  opacity: 0;

  .announcement-modal.is-open & {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.announcement-modal__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(18, 18, 22, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1.5px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);

  svg {
    transition: transform 0.2s ease;
  }

  &:hover {
    background: #ff6500;
    border-color: #ff6500;
    color: #ffffff;
    transform: scale(1.12);
    box-shadow: 0 8px 24px rgba(255, 101, 0, 0.55);

    svg {
      transform: rotate(90deg);
    }
  }

  &:active {
    transform: scale(0.95);
  }
}

.announcement-modal__content {
  overflow: hidden;
  border-radius: 24px;
  border: 2px solid rgba(255, 101, 0, 0.4);
  background: #000000;
  line-height: 0;
}

.announcement-modal__img {
  width: 100%;
  height: auto;
  max-height: 82vh;
  object-fit: contain;
  display: block;
  user-select: none;
  pointer-events: auto;
}

@media (max-width: 540px) {
  .announcement-modal {
    padding: 14px;
  }

  .announcement-modal__dialog {
    max-width: 390px;
  }

  .announcement-modal__close {
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;

    svg {
      width: 17px;
      height: 17px;
    }
  }

  .announcement-modal__content {
    border-radius: 20px;
  }
}
</style>

<script>
  function setupAnnouncementModal() {
    const isHomePage = window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '';
    if (!isHomePage) return;

    const modal = document.getElementById('announcement-modal');
    if (!modal) return;

    let hasOpened = false;
    let isClosedByUser = false;

    function openModal() {
      if (hasOpened || isClosedByUser) return;
      hasOpened = true;

      // Small tick for smooth animation
      requestAnimationFrame(() => {
        modal?.classList.add('is-open');
        modal?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeModal() {
      isClosedByUser = true;
      modal?.classList.remove('is-open');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach click listeners to close triggers (close button + backdrop overlay)
    const closers = modal.querySelectorAll('[data-modal-close]');
    closers.forEach((btn) => {
      btn.addEventListener('click', closeModal);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Listen for intro completion
    window.addEventListener('intro-complete', () => {
      setTimeout(openModal, 250);
    });

    // Fallback: If intro overlay is not present or already dismissed
    const introOverlay = document.getElementById('brand-intro-overlay');
    if (!introOverlay || document.documentElement.classList.contains('no-intro-overlay')) {
      setTimeout(openModal, 400);
    } else {
      // Safety timeout: Open after intro duration if event was missed
      setTimeout(() => {
        if (!hasOpened) openModal();
      }, 4200);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAnnouncementModal);
  } else {
    setupAnnouncementModal();
  }
  document.addEventListener('astro:page-load', setupAnnouncementModal);
</script>
