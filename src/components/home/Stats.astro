---
import { siteConfig } from '@/data/config';
---
<section class="stats" aria-label="Symposium highlights">
  <div class="container stats-grid">
    <div><strong>40+</strong><span>Events</span></div>
    <div><strong>8</strong><span>Departments</span></div>
    <div><strong>₹1,00,000+</strong><span>Cash Prizes</span></div>
    <div><strong>₹250</strong><span>Per Head</span></div>
    <div><strong>{siteConfig.shortDate}</strong><span>Event Date</span></div>
  </div>
</section>

<style lang="scss">
@use '../../styles/variables' as *;
.stats { padding: 44px 0; color: white; background: $black; }
.stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); text-align: center; gap: 16px; }
.stats strong { display: block; color: $orange; font: clamp(2rem, 3.8vw, 3.5rem) $display; line-height: 1; }
.stats span { display: block; margin-top: 8px; color: rgba(255,255,255,.4); font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
@media (max-width: 820px) { .stats-grid { grid-template-columns: repeat(3, 1fr); gap: 24px 12px; } }
@media (max-width: 560px) { .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 24px 10px; } }
</style>
