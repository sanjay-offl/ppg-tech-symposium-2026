<section class="cta"><div class="container"><span class="section-label">Join the Race</span><h2>JOIN NOW.<br />WIN BIG.</h2><p>One registration unlocks all events, lunch, refreshments, and a certificate.<br />Only <strong>₹250 per head.</strong></p><a class="button" href="/register">Register Now</a><div class="perks"><span>Certificate for all participants</span><span>Lunch & refreshments included</span><span>Cash prizes for winners</span></div></div></section><style lang="scss">@use '../../styles/variables' as *;.cta { position: relative; overflow: hidden; padding: 110px 0; color: white; background: $black; text-align: center; }.cta::before { content: 'REGISTER'; position: absolute; inset: 30% auto auto 50%; transform: translateX(-50%); color: rgba(255,255,255,.025); font: clamp(6rem, 19vw, 16rem) $display; white-space: nowrap; }.cta .container { position: relative; }.cta .section-label { justify-content: center; }.cta h2 { margin: 18px 0; font: clamp(3.5rem, 8vw, 6rem)/.86 $display; }.cta p { margin: 0 0 32px; color: rgba(255,255,255,.55); line-height: 1.7; }.cta strong { color: $orange; }.perks { display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; margin-top: 38px; color: rgba(255,255,255,.5); font-size: .78rem; }.perks span::before { content: ''; display: inline-block; width: 5px; height: 5px; margin: 0 8px 2px 0; border-radius: 50%; background: $orange; }</style>
