---
const targetDate = '2026-09-25T09:00:00+05:30';
---
<div class="countdown-wrap" data-countdown data-target={targetDate} aria-label="Countdown to VIYUGAM 2K26">
  <p class="countdown-kicker"><span aria-hidden="true"></span>Race Starts In</p>
  <div class="countdown" role="timer" aria-live="polite">
    <div class="countdown-block"><span data-unit="days">00</span><small>Days</small></div>
    <i class="countdown-separator" aria-hidden="true"></i>
    <div class="countdown-block"><span data-unit="hours">00</span><small>Hrs</small></div>
    <i class="countdown-separator" aria-hidden="true"></i>
    <div class="countdown-block"><span data-unit="minutes">00</span><small>Mins</small></div>
    <span class="countdown-dot" data-blink aria-hidden="true">●</span>
    <div class="countdown-block"><span data-unit="seconds">00</span><small>Secs</small></div>
  </div>
</div>

<style lang="scss">
@use '../../styles/variables' as *;

.countdown-wrap { margin: 0 0 26px; }
.countdown-kicker { display: flex; align-items: center; gap: 8px; margin: 0 0 5px; color: $orange; font-size: .68rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
.countdown-kicker span { display: inline-block; width: 24px; height: 1px; background: $orange; }
.countdown { display: flex; align-items: center; width: max-content; max-width: 100%; }
.countdown-block { display: flex; min-width: 64px; flex-direction: column; align-items: center; }
.countdown-block span { color: $black; font: 64px/.82 $display; letter-spacing: .01em; }
.countdown-block small { margin-top: 7px; color: #9ca3af; font-size: .62rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
.countdown-separator { width: 1px; height: 40px; margin: 0 10px; background: $orange; }
.countdown-dot { align-self: flex-start; margin: 3px 8px 0 5px; color: $orange; font-size: 1.35rem; line-height: 1; }
.countdown-finished { color: $orange; font: 700 2rem/1 $display; letter-spacing: .08em; text-transform: uppercase; }
@media (max-width: 760px) { .countdown-wrap { margin-bottom: 24px; }.countdown-kicker { justify-content: center; }.countdown { margin-inline: auto; }.countdown-block { min-width: 52px; }.countdown-block span { font-size: 40px; }.countdown-block small { margin-top: 5px; font-size: .55rem; letter-spacing: .1em; }.countdown-separator { height: 30px; margin-inline: 6px; }.countdown-dot { margin-right: 4px; margin-left: 2px; font-size: 1rem; }.countdown-finished { font-size: 1.7rem; text-align: center; } }
</style>

<script>
const countdown = document.querySelector<HTMLElement>('[data-countdown]');

if (countdown) {
  const target = new Date(countdown.dataset.target ?? '').getTime();
  const timer = countdown.querySelector<HTMLElement>('[role="timer"]');
  const blink = countdown.querySelector<HTMLElement>('[data-blink]');
  let interval: number | undefined;

  const pad = (value: number) => String(value).padStart(2, '0');
  const update = () => {
    const diff = Math.max(0, target - Date.now());
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const minutes = Math.floor((diff % 3600000) / 60000);
    const seconds = Math.floor((diff % 60000) / 1000);

    if (diff === 0) {
      countdown.innerHTML = '<p class="countdown-finished" role="status">Race Starts Now 🏁</p>';
      if (interval) window.clearInterval(interval);
      return;
    }

    countdown.querySelector('[data-unit="days"]')!.textContent = pad(days);
    countdown.querySelector('[data-unit="hours"]')!.textContent = pad(hours);
    countdown.querySelector('[data-unit="minutes"]')!.textContent = pad(minutes);
    countdown.querySelector('[data-unit="seconds"]')!.textContent = pad(seconds);
    if (timer) timer.setAttribute('aria-label', `${days} days, ${hours} hours, ${minutes} minutes, ${seconds} seconds remaining`);
    if (blink) blink.style.opacity = blink.style.opacity === '0' ? '1' : '0';
  };

  update();
  interval = window.setInterval(update, 1000);
  document.addEventListener('astro:before-preparation', () => { if (interval) window.clearInterval(interval); }, { once: true });
}
</script>
