---
const guidelines = [
  'All participants must bring their own valid college ID cards.',
  'Participants must carry essential articles (pen drive, standees, poster, laptops, prototypes or models) for their respective events.',
  'Participants must abide by the final decision given by the panellists.',
  'All participants must follow the rules and regulations; failing to do so will result in cancellation of participation.',
  'Any kind of misbehaviour will lead to disqualification.',
  'Lunch and appetizers will be provided to all registered participants.',
  'Participants must register before the event begins and report to the venue on time.',
  'The decision of event coordinators and judges is final in all matters.',
  'Any form of malpractice or disruptive behaviour may lead to disqualification.',
  'Event-specific equipment, software, time limits, and participation formats will be announced by coordinators before each round.',
  'Participants are responsible for following the rules and instructions announced before each round.'
];
---

<section class="symposium-guidelines" aria-labelledby="guidelines-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">OFFICIAL CODE & REGULATIONS</span>
      <h2 id="guidelines-heading" class="section-title">GENERAL SYMPOSIUM GUIDELINES</h2>
      <p class="section-desc">
        Essential instructions for all registered participants attending VIYUGAM 2K26. Please review carefully to ensure seamless participation.
      </p>
    </div>

    <div class="guidelines-grid">
      {guidelines.map((item, index) => (
        <div class="guideline-card">
          <span class="card-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <p class="card-text">{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
@use '../../styles/variables' as *;

.symposium-guidelines {
  padding: 80px 0;
  background: #0a0a0a;
  color: #ffffff;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.section-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 48px;
}

.section-tag {
  display: inline-block;
  font-family: $technical;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: $orange;
  margin-bottom: 12px;
}

.section-title {
  font-family: $display;
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: 0.02em;
  line-height: 1;
  color: #ffffff;
  margin: 0 0 16px;
}

.section-desc {
  font-family: $body;
  font-size: 0.95rem;
  line-height: 1.6;
  color: #a3a3a3;
  margin: 0;
}

.guidelines-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 16px;
}

.guideline-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 20px;
  background: #141414;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  transition: transform 0.2s ease, border-color 0.2s ease;

  &:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 101, 0, 0.4);
  }
}

.card-num {
  flex-shrink: 0;
  font-family: $technical;
  font-size: 1.1rem;
  font-weight: 700;
  color: $orange;
  line-height: 1;
  padding-top: 2px;
}

.card-text {
  font-family: $body;
  font-size: 0.88rem;
  line-height: 1.55;
  color: #d4d4d4;
  margin: 0;
}

@media (max-width: 640px) {
  .symposium-guidelines {
    padding: 56px 0;
  }
  .guidelines-grid {
    grid-template-columns: 1fr;
  }
  .guideline-card {
    padding: 16px;
  }
}
</style>
