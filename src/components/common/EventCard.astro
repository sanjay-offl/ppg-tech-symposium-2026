---
import type { EventItem } from '@/types';
import EventBadge from './EventBadge.astro';
import { getDepartmentBySlug } from '@/data/departments';

interface Props {
  event: EventItem;
  showDepartment?: boolean;
  showRegister?: boolean;
}

const { event, showDepartment = false, showRegister = false } = Astro.props;
const summary = event.concept || event.description;
const formatDetails = [
  event.format ? event.format : `Team: ${event.teamSize}`,
  event.duration ? event.duration : null,
  event.venue ? event.venue : 'Campus'
].filter(Boolean).join(' • ');

const deptObj = event.departmentSlug ? getDepartmentBySlug(event.departmentSlug) : undefined;
const regUrl = deptObj?.registrationUrl || `/register?event=${event.slug}`;
const isExternalReg = Boolean(deptObj?.registrationUrl);
---

<article class="event-card">
  <div class="card-header">
    <div class="header-main">
      <h3 class="event-title">{event.name}</h3>
      {showDepartment && <span class="dept-badge">{event.department}</span>}
    </div>
    <EventBadge type={event.category} />
  </div>

  <p class="card-body">
    {summary}
  </p>

  <div class="format-line">
    <svg class="format-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span class="format-text">{formatDetails}</span>
  </div>

  {event.coordinators && event.coordinators.length > 0 && (
    <div class="card-coordinators">
      <div class="coord-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>Event Coordinators</span>
      </div>
      <div class="coord-list">
        {event.coordinators.map((coordStr) => {
          const parts = coordStr.split(' — ');
          const name = parts[0];
          const phone = parts[1] || '';
          const cleanPhone = phone.replace(/[^\d+]/g, '');
          const telHref = cleanPhone ? (cleanPhone.startsWith('+') ? cleanPhone : `+91${cleanPhone}`) : '';
          return telHref ? (
            <a href={`tel:${telHref}`} class="coord-tag coord-tag--link" title={`Call ${name}`}>
              <span class="coord-name">{name}</span>
              <span class="coord-phone">📞 {phone}</span>
            </a>
          ) : (
            <span class="coord-tag">{coordStr}</span>
          );
        })}
      </div>
    </div>
  )}

  <div class="card-actions">
    <a href={`/events/${event.slug}`} class="btn-details">
      View Details
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    {showRegister && (
      <a
        href={regUrl}
        target={isExternalReg ? "_blank" : undefined}
        rel={isExternalReg ? "noopener noreferrer" : undefined}
        class="btn-register"
      >
        Register
      </a>
    )}
  </div>
</article>

<style lang="scss">
@use '../../styles/variables' as *;

.event-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 24px;
  background: #ffffff; /* Crisp white card */
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-top: 3.5px solid $orange;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.25s ease,
              box-shadow 0.25s ease;
  position: relative;
  overflow: hidden;

  &:hover {
    transform: translateY(-4px);
    border-color: $orange;
    box-shadow: 0 16px 36px rgba(255, 101, 0, 0.16);
  }
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.header-main {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.event-title {
  font-family: $display;
  font-size: 1.55rem;
  letter-spacing: 0.03em;
  line-height: 1.1;
  color: #0a0a0a;
  margin: 0;
}

.dept-badge {
  font-family: $technical;
  font-size: 0.72rem;
  font-weight: 700;
  color: $orange;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: rgba(255, 101, 0, 0.08);
  padding: 2px 8px;
  border-radius: 4px;
  width: fit-content;
}

.card-body {
  font-family: $body;
  font-size: 0.88rem;
  line-height: 1.55;
  color: #1a1a1a;
  font-weight: 450;
  margin: 0 0 16px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex-grow: 1;
}

.format-line {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  background: #f8f8fa;
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-radius: 8px;
  margin-bottom: 18px;
  font-family: $technical;
  font-size: 0.78rem;
  font-weight: 700;
  color: #0a0a0a;
  letter-spacing: 0.03em;
}

.format-icon {
  flex-shrink: 0;
  color: $orange;
}

.format-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-coordinators {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 12px;
  background: #f8f9fa;
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-radius: 10px;
  margin-bottom: 18px;
}

.coord-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: $technical;
  font-size: 0.72rem;
  font-weight: 700;
  color: $orange;
  text-transform: uppercase;
  letter-spacing: 0.06em;

  svg {
    flex-shrink: 0;
  }
}

.coord-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.coord-tag {
  font-family: $technical;
  font-size: 0.78rem;
  font-weight: 600;
  color: #111827;
  background: #ffffff;
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid rgba(10, 10, 10, 0.1);
  line-height: 1.35;
}

.coord-tag--link {
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  transition: all 0.2s ease;
  cursor: pointer;

  &:hover {
    border-color: $orange;
    background: rgba(255, 101, 0, 0.06);
    color: $orange;

    .coord-phone {
      text-decoration: underline;
    }
  }

  .coord-phone {
    color: $orange;
    font-weight: 700;
    white-space: nowrap;
  }
}

.card-actions {
  display: flex;
  gap: 10px;
  margin-top: auto;
}

.btn-details {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 6px;
  padding: 10px 14px;
  border-radius: 10px;
  background: #0a0a0a;
  border: 1px solid #0a0a0a;
  color: #ffffff;
  font-family: $technical;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s ease;

  svg {
    transition: transform 0.2s ease;
  }

  &:hover {
    background: $orange;
    border-color: $orange;
    color: #ffffff;

    svg {
      transform: translateX(3px);
    }
  }
}

.btn-register {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 18px;
  border-radius: 10px;
  background: $orange;
  border: 1px solid $orange;
  color: #ffffff;
  font-family: $technical;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s ease;

  &:hover {
    background: #ff7a00;
    border-color: #ff7a00;
    box-shadow: 0 4px 16px rgba(255, 101, 0, 0.4);
  }
}



@media (max-width: 640px) {
  .event-card {
    padding: 14px 16px;
    border-radius: 12px;
    border-top-width: 3px;
  }
  .card-header {
    margin-bottom: 8px;
    gap: 8px;
  }
  .event-title {
    font-size: 1.18rem;
  }
  .dept-badge {
    font-size: 0.65rem;
    padding: 1px 6px;
  }
  .card-body {
    font-size: 0.8rem;
    line-height: 1.45;
    margin-bottom: 10px;
    -webkit-line-clamp: 2;
  }
  .format-line {
    padding: 6px 10px;
    margin-bottom: 10px;
    font-size: 0.72rem;
    gap: 6px;
    border-radius: 6px;

    .format-icon {
      width: 12px;
      height: 12px;
    }
  }
  .card-coordinators {
    padding: 6px 10px;
    margin-bottom: 10px;
    gap: 4px;
    border-radius: 8px;
  }
  .coord-label {
    font-size: 0.66rem;
    gap: 4px;

    svg {
      width: 11px;
      height: 11px;
    }
  }
  .coord-tag {
    font-size: 0.72rem;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .card-actions {
    gap: 8px;
  }
  .btn-details, .btn-register {
    padding: 7px 10px;
    font-size: 0.75rem;
    border-radius: 8px;
  }
}

@media (max-width: 420px) {
  .event-card {
    padding: 12px 14px;
  }
  .event-title {
    font-size: 1.1rem;
  }
}
</style>
