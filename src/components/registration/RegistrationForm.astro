---
import { departments } from '@/data/departments';
import { events } from '@/data/events';
---
<form class="registration-form" data-registration-form novalidate><div class="form-heading"><span class="section-label">Participant details</span><h2>ENTER THE RACE.</h2><p>One registration unlocks all events, lunch, refreshments, and a certificate.</p></div><div class="form-grid"><label>Full Name<input name="fullName" required autocomplete="name" /><span class="error" data-error="fullName"></span></label><label>Email<input name="email" type="email" required autocomplete="email" /><span class="error" data-error="email"></span></label><label>Phone Number<input name="phone" inputmode="tel" required autocomplete="tel" /><span class="error" data-error="phone"></span></label><label>College Name<input name="collegeName" required /><span class="error" data-error="collegeName"></span></label><label>Department<select name="department" required><option value="">Select department</option>{departments.map((department) => <option value={department.name}>{department.name}</option>)}</select><span class="error" data-error="department"></span></label><label>Year of Study<select name="yearOfStudy" required><option value="">Select year</option><option>First Year</option><option>Second Year</option><option>Third Year</option><option>Final Year</option></select><span class="error" data-error="yearOfStudy"></span></label><label>Selected Event<select name="selectedEvent" required><option value="">Select event</option>{events.map((event) => <option value={event.name}>{event.name}</option>)}</select><span class="error" data-error="selectedEvent"></span></label><label>Team Name <small>(if applicable)</small><input name="teamName" /></label><label class="full">Additional Event-Specific Fields<textarea name="additionalDetails" rows="4"></textarea></label></div><div class="form-actions"><p>Registration fee: <strong>₹250 per head</strong></p><button class="button" type="submit">Submit Registration</button></div><p class="form-status" role="status" data-form-status></p></form>
<style lang="scss">@use '../../styles/variables' as *;.registration-form { padding: clamp(24px, 5vw, 54px); border: 1px solid $line; border-radius: 18px; background: white; box-shadow: 0 18px 60px rgba(0,0,0,.07); }.form-heading h2 { margin: 12px 0 8px; font: clamp(2.6rem, 6vw, 4.5rem)/.9 $display; }.form-heading p { color: $muted; }.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 32px; }.form-grid label { display: grid; gap: 7px; color: #333; font-size: .76rem; font-weight: 700; }.form-grid input, .form-grid select, .form-grid textarea { width: 100%; padding: 13px 14px; border: 1px solid #d7d7dc; border-radius: 8px; outline: none; background: #fafafa; }.form-grid input:focus, .form-grid select:focus, .form-grid textarea:focus { border-color: $orange; box-shadow: 0 0 0 3px rgba(255,101,0,.12); }.form-grid .full { grid-column: 1 / -1; }.error { min-height: 14px; color: #b32727; font-size: .68rem; }.form-actions { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 24px; }.form-actions p { color: $muted; font-size: .82rem; }.form-actions strong { color: $orange; }.form-status { margin: 16px 0 0; color: #16834a; font-size: .85rem; font-weight: 600; }.form-status.error-status { color: #b32727; } @media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; }.form-grid .full { grid-column: auto; }.form-actions { align-items: stretch; flex-direction: column; }.form-actions .button { width: 100%; } }</style>
<script>
import { submitToGoogleSheet } from '../../services/googleSheets';
const form = document.querySelector<HTMLFormElement>('[data-registration-form]');
form?.addEventListener('submit', async (event) => { event.preventDefault(); const status = form.querySelector<HTMLElement>('[data-form-status]'); const button = form.querySelector<HTMLButtonElement>('button[type="submit"]'); const data = Object.fromEntries(new FormData(form).entries()); let valid = true; form.querySelectorAll<HTMLElement>('.error').forEach((node) => node.textContent = ''); for (const field of ['fullName','email','phone','collegeName','department','yearOfStudy','selectedEvent']) { const value = String(data[field] ?? '').trim(); const error = form.querySelector<HTMLElement>(`[data-error="${field}"]`); if (!value) { if (error) error.textContent = 'This field is required.'; valid = false; } if (field === 'email' && value && !/^\S+@\S+\.\S+$/.test(value)) { if (error) error.textContent = 'Enter a valid email.'; valid = false; } if (field === 'phone' && value && !/^\+?[0-9\s-]{10,15}$/.test(value)) { if (error) error.textContent = 'Enter a valid phone number.'; valid = false; } } if (!valid || !status || !button) return; button.disabled = true; button.textContent = 'Submitting...'; status.textContent = ''; try { await submitToGoogleSheet(data, 'Registrations'); form.reset(); status.textContent = 'Registration received. We will contact you with the next steps.'; } catch { status.textContent = 'Submission could not be completed. Please email the coordinator.'; status.classList.add('error-status'); } finally { button.disabled = false; button.textContent = 'Submit Registration'; } });
</script>
