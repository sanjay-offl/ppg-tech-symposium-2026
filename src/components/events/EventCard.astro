---
import type { EventItem } from '@/types';
const { event } = Astro.props as { event: EventItem };
---
<article class="event-card" data-department={event.department}><div class="event-top"><span>{event.category}</span><em>{event.registrationStatus}</em></div><h3>{event.name}</h3><p>{event.description}</p><dl><div><dt>Department</dt><dd>{event.department}</dd></div><div><dt>Team size</dt><dd>{event.teamSize}</dd></div></dl><a href={`/events/${event.slug}`}>View event <span aria-hidden="true">↗</span></a></article>
<style lang="scss">@use '../../styles/variables' as *;.event-card { display: flex; flex-direction: column; padding: 22px; border: 1px solid $line; border-radius: 14px; background: white; }.event-top { display: flex; justify-content: space-between; color: $orange; font: 700 .66rem $technical; letter-spacing: .11em; text-transform: uppercase; }.event-top em { color: #16834a; font-style: normal; letter-spacing: .04em; }.event-card h3 { margin: 22px 0 8px; font: 1.7rem $display; letter-spacing: .02em; }.event-card p { min-height: 52px; margin: 0; color: $muted; font-size: .82rem; line-height: 1.6; }.event-card dl { display: grid; gap: 8px; margin: 20px 0; padding-top: 15px; border-top: 1px solid $line; }.event-card dt { color: $muted; font-size: .64rem; text-transform: uppercase; }.event-card dd { margin: 2px 0 0; font-size: .78rem; }.event-card a { margin-top: auto; color: $orange; font-size: .82rem; font-weight: 700; text-decoration: none; }.event-card a span { transition: transform .2s; display: inline-block; }.event-card a:hover span { transform: translate(3px, -3px); }</style>
