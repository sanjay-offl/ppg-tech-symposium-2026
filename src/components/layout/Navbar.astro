---
import { departments } from '@/data/departments';
---
<nav class="navbar" aria-label="Primary navigation">
  <a class="brand" href="/" aria-label="VIYUGAM 2K26 home"><img class="brand-logo" src="/images/departments/logo.avif" alt="PPG Institute of Technology logo" /><span>VIYUGAM <b>2K26</b></span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-links"><span class="sr-only">Toggle navigation</span><span></span><span></span></button>
  <ul class="nav-links" id="primary-links">
    <li><a href="/about">About</a></li>
    <li class="has-dropdown">
      <a href="/#departments" class="dropdown-trigger">
        Departments <span class="caret" aria-hidden="true">▾</span>
      </a>
      <div class="dropdown-menu" role="menu">
        <a href="/#departments" class="dropdown-item overview-item" role="menuitem">
          <strong>All Departments</strong>
          <small>Explore 7 Tracks & Events</small>
        </a>
        <div class="dropdown-divider"></div>
        {departments.map((dept) => (
          <a href={`/departments/${dept.slug}`} class="dropdown-item" role="menuitem">
            <span class="dept-tag">{dept.abbr}</span>
            <span class="dept-fullname">{dept.name}</span>
          </a>
        ))}
      </div>
    </li>
    <li><a href="/schedule">Schedule</a></li>
    <li><a href="/faq">FAQ</a></li>
    <li><a class="nav-cta" href="/register">Register · ₹250</a></li>
  </ul>
</nav>
<style lang="scss">
@use '../../styles/variables' as *;
.navbar { position: fixed; z-index: 100; top: 20px; left: 50%; transform: translateX(-50%); width: min(920px, calc(100% - 32px)); min-height: 54px; display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border: 1px solid rgba(255,255,255,.9); border-radius: 999px; background: rgba(255,255,255,.8); backdrop-filter: blur(24px); box-shadow: 0 4px 24px rgba(0,0,0,.08); transition: background .25s, box-shadow .25s; }
.brand { display: inline-flex; align-items: center; gap: 8px; font: 700 14px/1 $technical; text-decoration: none; letter-spacing: .04em; white-space: nowrap; }
.brand-logo { display: block; width: 32px; height: 32px; object-fit: contain; flex: 0 0 32px; }
.brand b { color: $orange; }
.nav-links { display: flex; align-items: center; gap: 2px; margin: 0; padding: 0; list-style: none; }
.nav-links a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px; border-radius: 999px; font-size: 12.5px; line-height: 1; text-decoration: none; color: inherit; }
.nav-links a:hover { background: rgba(0,0,0,.06); }
.nav-links .nav-cta { color: white; background: $orange; font-weight: 700; box-shadow: 0 3px 14px $orange-glow; }
.nav-links .nav-cta:hover { background: darken($orange, 4%); color: white; }

.has-dropdown {
  position: relative;
  display: inline-flex;
  align-items: center;

  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    
    .caret {
      font-size: 10px;
      transition: transform 0.2s ease;
    }
  }

  &:hover, &:focus-within {
    .dropdown-trigger .caret {
      transform: rotate(180deg);
    }
    .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
      pointer-events: auto;
    }
  }
}

.dropdown-menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  width: 290px;
  padding: 8px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(24px);
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.14);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
  display: flex;
  flex-direction: column;
  gap: 2px;
  z-index: 120;

  .dropdown-divider {
    height: 1px;
    background: rgba(0, 0, 0, 0.08);
    margin: 4px 0;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 10px;
    color: #111;
    text-decoration: none;
    font-size: 12px;
    min-height: auto;
    &:hover {
      background: rgba(255, 101, 0, 0.12);
      color: $orange;

      .dept-tag {
        background: $orange;
        color: #ffffff;
      }
    }

    &.overview-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 8px 10px;
      background: rgba(0, 0, 0, 0.03);

      strong {
        font-weight: 700;
        font-size: 12.5px;
        color: #111;
        transition: color 0.15s ease;
      }

      small {
        font-size: 11px;
        color: #666;
        transition: color 0.15s ease;
      }

      &:hover {
        background: rgba(255, 101, 0, 0.14);
        strong { color: $orange; }
        small { color: #444; }
      }
    }

    .dept-tag {
      font-family: $technical;
      font-weight: 700;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 4px;
      background: rgba(255, 101, 0, 0.15);
      color: $orange;
      min-width: 44px;
      text-align: center;
    }

    .dept-fullname {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 500;
    }
  }
}

.menu-toggle { display: none; border: 0; background: transparent; }

@media (max-width: 760px) {
  .navbar { top: 12px; min-height: 50px; padding: 7px 10px; }
  .brand { font-size: 13px; }
  .brand-logo { width: 30px; height: 30px; flex-basis: 30px; }
  .menu-toggle { display: grid; gap: 4px; padding: 8px; cursor: pointer; }
  .menu-toggle span:not(.sr-only) { width: 22px; height: 2px; background: $black; }
  .nav-links { position: absolute; top: calc(100% + 8px); left: 0; right: 0; display: none; padding: 12px; border-radius: 18px; background: white; box-shadow: 0 12px 28px rgba(0,0,0,.12); max-height: 80vh; overflow-y: auto; }
  .nav-links.is-open { display: flex; flex-direction: column; align-items: stretch; }
  .nav-links a { min-height: 42px; padding: 0 14px; }
  .has-dropdown {
    flex-direction: column;
    align-items: stretch;
    .dropdown-trigger { width: 100%; justify-content: space-between; }
    .dropdown-menu {
      position: static;
      transform: none;
      width: 100%;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      box-shadow: none;
      border: 1px solid rgba(0, 0, 0, 0.06);
      background: rgba(0, 0, 0, 0.02);
      padding: 6px;
      margin: 4px 0 8px;
      max-height: 240px;
      overflow-y: auto;
    }
  }
  .nav-links .nav-cta { justify-content: center; margin-top: 4px; }
}
</style>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
const links = document.querySelector<HTMLElement>('.nav-links');
toggle?.addEventListener('click', () => { const open = links?.classList.toggle('is-open') ?? false; toggle.setAttribute('aria-expanded', String(open)); });
window.addEventListener('scroll', () => document.querySelector('.navbar')?.classList.toggle('is-scrolled', window.scrollY > 60), { passive: true });
</script>

