---
import { departments } from '@/data/departments';
---
<nav class="navbar" aria-label="Primary navigation">
  <a class="brand" href="/" aria-label="VIYUGAM 2K26 home"><img class="brand-logo" src="/images/departments/logo.avif" alt="PPG Institute of Technology logo" /><span>VIYUGAM <b>2K26</b></span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-links"><span class="sr-only">Toggle navigation</span><span></span><span></span><span></span></button>
  <ul class="nav-links" id="primary-links">
    <li><a href="/">Home</a></li>
    <li><a href="/about">About</a></li>
    <li class="has-dropdown">
      <a href="/departments" class="dropdown-trigger">
        Departments <span class="caret" aria-hidden="true">▾</span>
      </a>
      <div class="dropdown-menu" role="menu">
        <a href="/departments" class="dropdown-item overview-item" role="menuitem">
          <strong>All Departments</strong>
          <small>Explore 8 Disciplines & 40+ Events</small>
        </a>
        <div class="dropdown-divider"></div>
        {departments.map((dept) => (
          <a href={`/departments/${dept.slug}`} class="dropdown-item" role="menuitem">
            <span class="dept-tag">{dept.abbr}</span>
            <span class="dept-fullname">{dept.name}</span>
          </a>
        ))}
      </div>
    </li>
    <li><a href="/schedule">Schedule</a></li>
    <li><a href="/faq">FAQ</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
</nav>

<style lang="scss">
@use "sass:color";
@use '../../styles/variables' as *;

.navbar {
  position: fixed;
  z-index: 100;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: min(920px, calc(100% - 32px));
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 14px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24px);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  transition: background 0.25s ease, box-shadow 0.25s ease;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font: 700 14px/1 $technical;
  text-decoration: none;
  letter-spacing: 0.04em;
  white-space: nowrap;
  color: #0a0a0a;

  b {
    color: $orange;
  }
}

.brand-logo {
  display: block;
  width: 32px;
  height: 32px;
  object-fit: contain;
  flex: 0 0 32px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 2px;
  margin: 0;
  padding: 0;
  list-style: none;

  a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 12.5px;
    line-height: 1;
    text-decoration: none;
    color: #111111;
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease;

    &:hover {
      background: rgba(0, 0, 0, 0.06);
    }
  }
}

.has-dropdown {
  position: relative;
  display: inline-flex;
  align-items: center;

  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;

    .caret {
      font-size: 10px;
      transition: transform 0.2s ease;
    }
  }

  @media (min-width: 761px) {
    &:hover, &:focus-within {
      .dropdown-trigger .caret {
        transform: rotate(180deg);
      }
      .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
      }
    }
  }
}

.dropdown-menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  width: 290px;
  padding: 8px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24px);
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.14);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
  display: flex;
  flex-direction: column;
  gap: 2px;
  z-index: 120;

  .dropdown-divider {
    height: 1px;
    background: rgba(0, 0, 0, 0.08);
    margin: 4px 0;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 10px;
    color: #111;
    text-decoration: none;
    font-size: 12px;
    min-height: auto;

    &:hover {
      background: rgba(255, 101, 0, 0.12);
      color: $orange;

      .dept-tag {
        background: $orange;
        color: #ffffff;
      }
    }

    &.overview-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 8px 10px;
      background: rgba(0, 0, 0, 0.03);

      strong {
        font-weight: 700;
        font-size: 12.5px;
        color: #111;
        transition: color 0.15s ease;
      }

      small {
        font-size: 11px;
        color: #666;
        transition: color 0.15s ease;
      }

      &:hover {
        background: rgba(255, 101, 0, 0.14);
        strong { color: $orange; }
        small { color: #444; }
      }
    }

    .dept-tag {
      font-family: $technical;
      font-weight: 700;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 4px;
      background: rgba(255, 101, 0, 0.15);
      color: $orange;
      min-width: 44px;
      text-align: center;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .dept-fullname {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 500;
    }
  }
}

.menu-toggle {
  display: none;
  border: 0;
  background: transparent;
}

@media (max-width: 760px) {
  .navbar {
    top: 12px;
    min-height: 50px;
    padding: 7px 14px;
  }
  .brand {
    font-size: 13px;
  }
  .brand-logo {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
  }
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 6px;
    cursor: pointer;

    span:not(.sr-only) {
      width: 20px;
      height: 2px;
      background: #0a0a0a;
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
  }

  .nav-links {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    display: none;
    padding: 14px;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.08);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15);
    max-height: 82vh;
    overflow-y: auto;
  }

  .nav-links.is-open {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
  }

  .nav-links li {
    width: 100%;
    display: flex;
  }

  .nav-links a {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    min-height: 46px;
    padding: 0 16px;
    font-size: 13.5px;
    font-weight: 600;

    &:active {
      background: rgba(255, 101, 0, 0.12);
      color: $orange;
    }
  }

  .has-dropdown {
    flex-direction: column;
    align-items: stretch;
    width: 100%;

    .dropdown-trigger {
      width: 100%;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: 12px;

      .caret {
        font-size: 12px;
        transition: transform 0.25s ease;
      }
    }

    .dropdown-menu {
      position: static;
      transform: none;
      width: 100%;
      box-sizing: border-box;
      box-shadow: none;
      border: 1px solid rgba(10, 10, 10, 0.08);
      border-radius: 14px;
      background: #f8f8fa;
      padding: 8px;
      margin: 6px 0 8px;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      pointer-events: none;
      transition: max-height 0.3s ease, opacity 0.25s ease, visibility 0.25s ease;
      display: flex;
      flex-direction: column;
      gap: 3px;

      .dropdown-item {
        width: 100%;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 12.5px;
        min-height: 42px;

        &:active {
          background: rgba(255, 101, 0, 0.18) !important;
          color: $orange;
        }

        .dept-tag {
          font-size: 9.5px;
          min-width: 44px;
          padding: 3px 6px;
        }

        .dept-fullname {
          font-size: 12.5px;
          font-weight: 500;
          flex: 1;
        }
      }
    }

    &.is-active {
      .dropdown-trigger {
        background: rgba(255, 101, 0, 0.08);
        color: $orange;

        .caret {
          transform: rotate(180deg);
        }
      }

      .dropdown-menu {
        opacity: 1;
        visibility: visible;
        max-height: 520px;
        pointer-events: auto;
      }
    }
  }
}
</style>

<script>
  function initNavbar() {
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const links = document.querySelector<HTMLElement>('.nav-links');
    const dropdown = document.querySelector<HTMLElement>('.has-dropdown');
    const dropdownTrigger = document.querySelector<HTMLElement>('.dropdown-trigger');

    // Mobile Hamburger Menu Toggle
    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = links?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Mobile Dropdown Accordion Toggle
    dropdownTrigger?.addEventListener('click', (e) => {
      if (window.innerWidth <= 760) {
        e.preventDefault();
        e.stopPropagation();
        dropdown?.classList.toggle('is-active');
      }
    });

    // Close Menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (links && !links.contains(target) && toggle && !toggle.contains(target)) {
        links.classList.remove('is-open');
        dropdown?.classList.remove('is-active');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close Menu on Link Clicks (except dropdown trigger on mobile)
    links?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 760 && link.classList.contains('dropdown-trigger')) {
          return;
        }
        links.classList.remove('is-open');
        dropdown?.classList.remove('is-active');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initNavbar);
  document.addEventListener('astro:page-load', initNavbar);
</script>

