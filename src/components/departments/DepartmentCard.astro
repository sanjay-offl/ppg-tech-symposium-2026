---
import type { Department } from '@/types';
const { department } = Astro.props as { department: Department };
---
<a href={`/departments/${department.slug}`} class="department-card-link">
  <article class="department-card">
    <div class="dept-card-header">
      <span class="dept-abbr-badge">{department.abbr}</span>
    </div>
    <h3 class="department-name">{department.name}</h3>
    <div class="events-content">
      <div class="event-group"><small>Technical</small><ul>{department.technicalEvents.map((event) => <li>{event}</li>)}</ul></div>
      <div class="event-group"><small>Non-Technical</small><ul>{department.nonTechnicalEvents.map((event) => <li>{event}</li>)}</ul></div>
    </div>
    <div class="card-action">View Events Details ➔</div>
  </article>
</a>

<style lang="scss">
@use '../../styles/variables' as *;

.department-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
  height: 100%;
}

@media (max-width: 768px) {
  .department-card-link {
    width: 100%;
    max-width: 325px;
    margin-inline: auto;
  }
}

.department-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  overflow: hidden;
  padding: 0 24px 22px;
  border-radius: 14px;
  color: $black;
  background: #ffffff;
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-top: 3px solid $orange;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
              background 350ms ease,
              border-color 350ms ease,
              box-shadow 350ms ease;
  cursor: pointer;
}

.dept-card-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24px 0 12px;
}

.dept-abbr-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 68px;
  height: 38px;
  padding: 0 16px;
  border-radius: 999px;
  background: rgba(255, 101, 0, 0.08);
  border: 1px solid rgba(255, 101, 0, 0.25);
  color: $orange;
  font: 900 1.1rem/1 $technical;
  letter-spacing: 0.08em;
  transition: all 0.3s ease;
}

.department-name {
  margin: 0;
  padding: 0 4px;
  color: $black;
  font: 700 1.02rem/1.2 $technical;
  letter-spacing: .03em;
  text-align: center;
  text-transform: uppercase;
  min-height: 2.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 350ms ease, text-shadow 350ms ease;
}

.events-content {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-height: 0;
}

.event-group {
  position: relative;
  margin-top: 14px;
}

.event-group small {
  display: flex;
  align-items: center;
  gap: 7px;
  color: $muted;
  font-size: .62rem;
  font-weight: 700;
  font-family: $technical;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition: color 350ms ease;
}

.event-group small::after {
  content: '';
  flex: 1;
  height: 1px;
  background: $line;
  transition: background 350ms ease;
}

.event-group ul {
  display: grid;
  gap: 8px;
  margin: 8px 0 0;
  padding: 0;
  list-style: none;
}

.event-group li {
  color: #333338;
  font-family: $body;
  font-size: .78rem;
  line-height: 1.45;
  padding: 1px 0;
}

.event-group li::before {
  content: '>';
  margin-right: 6px;
  color: $orange;
  font-weight: 700;
  transition: color 350ms ease, text-shadow 350ms ease;
}

.card-action {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid $line;
  color: $orange;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-align: center;
  text-transform: uppercase;
  transition: transform 350ms ease, color 350ms ease, border-color 350ms ease;
}

/* === INDEPENDENT HOVER INTERACTION: MILD SUBTLE ORANGE SHADE ON HOVER === */
.department-card:hover,
.department-card:focus-within,
.department-card:active {
  transform: translateY(-6px) scale(1.02);
  background: #ffffff;
  border-color: $orange;
  border-top-color: $orange;
  box-shadow: 0 16px 36px rgba(255, 101, 0, 0.18), 0 0 0 1px $orange;

  .department-name {
    color: $orange;
  }

  .event-group small {
    color: $orange;
    font-weight: 700;
  }

  .event-group small::after {
    background: rgba(255, 101, 0, 0.3);
  }

  .event-group li::before {
    color: $orange;
  }

  .event-group li {
    color: $black;
  }

  .card-action {
    color: $orange;
    border-top-color: rgba(255, 101, 0, 0.3);
    transform: translateX(4px);
  }

  .dept-abbr-badge {
    background: $orange;
    color: #ffffff;
    border-color: $orange;
    box-shadow: 0 4px 14px rgba(255, 101, 0, 0.35);
  }
}

/* MOBILE STYLES (Single column portrait stacked cards on mobile/tablet) */
@media (max-width: 768px) {
  .department-card {
    padding: 0 20px 20px;
    border-radius: 16px;
    border-top-width: 3px;
  }
  .track-visual {
    height: 100px;
    margin: 0 -20px 14px;
  }
  .track-visual img {
    width: 76%;
    height: 76%;
  }
  .department-name {
    font-size: 1.1rem;
    letter-spacing: 0.06em;
  }
  .event-group {
    margin-top: 12px;
  }
  .event-group small {
    font-size: 0.65rem;
    gap: 6px;
  }
  .event-group ul {
    gap: 9px;
    margin-top: 8px;
  }
  .event-group li {
    font-size: 0.84rem;
    line-height: 1.4;
    padding: 2px 0;
  }
  .event-group li::before {
    margin-right: 6px;
  }
  .card-action {
    margin-top: 16px;
    padding-top: 12px;
    font-size: 0.74rem;
  }
}
</style>
