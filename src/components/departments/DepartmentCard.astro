---
import type { Department } from '@/types';
const { department } = Astro.props as { department: Department };
---
<article class="department-card">
  <div class="track-visual">
    <img src={department.image} alt={`${department.name} track`} loading="lazy" />
    <div class="track-shade"></div>
  </div>
  <h3 class="department-name">{department.abbr}</h3>
  <div class="events-content">
    <div class="event-group"><small>Technical</small><ul>{department.technicalEvents.map((event) => <li>{event}</li>)}</ul></div>
    <div class="event-group"><small>Non-Technical</small><ul>{department.nonTechnicalEvents.map((event) => <li>{event}</li>)}</ul></div>
  </div>
  <div class="contact">{department.coordinators.map((coordinator) => <span>{coordinator}</span>)}<a href={`mailto:${department.email}`}>{department.email}</a></div>
</article>

<style lang="scss">
@use '../../styles/variables' as *;
.department-card { position: relative; display: flex; flex-direction: column; min-width: 0; height: 100%; overflow: hidden; padding: 0 28px 28px; border-top: 3px solid $orange; border-radius: 15px; color: white; background: $card; transition: transform .25s, box-shadow .25s; }
.department-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,.18); }
.track-visual { position: relative; display: grid; place-items: center; height: 154px; margin: 0 -28px 24px; overflow: hidden; isolation: isolate; background: radial-gradient(circle at center, rgba(255,101,0,.18), transparent 68%), #171719; }
.track-visual img { position: absolute; z-index: -2; width: 86%; height: 86%; object-fit: contain; opacity: .78; filter: drop-shadow(0 0 7px rgba(255,255,255,.2)); transition: transform .35s ease, opacity .35s ease; }
.department-card:hover .track-visual img { transform: scale(1.08) rotate(-2deg); opacity: 1; }
.track-shade { position: absolute; z-index: -1; inset: 0; background: rgba(0,0,0,.4); }
.department-name { margin: 0; padding: 0 4px; color: white; font: 700 1rem/1.1 $technical; letter-spacing: .1em; text-align: center; text-transform: uppercase; }
.events-content { display: flex; flex: 1 1 auto; flex-direction: column; min-height: 0; }
.event-group { position: relative; margin-top: 16px; }
.event-group small { display: flex; align-items: center; gap: 7px; color: rgba(255,255,255,.4); font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
.event-group small::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.1); }
.event-group ul { display: grid; gap: 5px; margin: 8px 0 0; padding: 0; list-style: none; }
.event-group li { color: rgba(255,255,255,.75); font-size: .8rem; }
.event-group li::before { content: '>'; margin-right: 7px; color: $orange; }
.contact { display: grid; gap: 3px; margin-top: auto; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.09); color: rgba(255,255,255,.4); font-size: .68rem; }
.contact a { color: inherit; text-decoration: none; }
.contact a:hover { color: white; }
</style>
