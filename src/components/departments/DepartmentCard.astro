---
import type { Department } from '@/types';
const { department } = Astro.props as { department: Department };
---
<a href={`/departments/${department.slug}`} class="department-card-link">
  <article class="department-card">
    <div class="dept-card-header">
      {department.image ? (
        <div class="dept-logo-badge">
          <img src={department.image} alt={`${department.name} Logo`} class="dept-logo-img" />
        </div>
      ) : (
        <div class="dept-abbr-badge">
          <span>{department.abbr}</span>
        </div>
      )}
    </div>
    <h3 class="department-name">{department.name}</h3>
    <div class="events-content">
      <div class="event-group"><small>Technical</small><ul>{department.technicalEvents.map((event) => <li>{event}</li>)}</ul></div>
      <div class="event-group"><small>Non-Technical</small><ul>{department.nonTechnicalEvents.map((event) => <li>{event}</li>)}</ul></div>
    </div>
    <div class="card-action">View Events Details ➔</div>
  </article>
</a>

<style lang="scss">
@use '../../styles/variables' as *;

.department-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
  height: 100%;
}

@media (max-width: 768px) {
  .department-card-link {
    width: 100%;
    max-width: 340px;
    margin-inline: auto;
  }
}

.department-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  min-height: 510px;
  overflow: hidden;
  padding: 0 28px 28px;
  border-radius: 18px;
  color: #0a0a0a;
  background: #ffffff; /* Crisp white card */
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-top: 4px solid $orange;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
  transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
              background 350ms ease,
              border-color 350ms ease,
              box-shadow 350ms ease;
  cursor: pointer;
}

.dept-card-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24px 0 10px;
  height: 106px;
}

.dept-logo-badge,
.dept-abbr-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76px;
  height: 76px;
  border-radius: 18px;
  box-sizing: border-box;
  padding: 8px;
  background: #ffffff !important; /* Pure white background for all logos */
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.dept-logo-badge {
  border: 1.5px solid rgba(10, 10, 10, 0.1);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
}

.dept-abbr-badge {
  border: 1.5px solid rgba(255, 101, 0, 0.4);
  color: $orange;
  font: 900 1.25rem/1 $technical;
  letter-spacing: 0.06em;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
}

.dept-logo-img {
  width: 100%;
  height: 100%;
  max-width: 60px;
  max-height: 60px;
  object-fit: contain;
  display: block;
  transition: transform 0.35s ease;
}

.department-name {
  margin: 0 0 8px;
  padding: 0 4px;
  color: #0a0a0a;
  font: 700 1.15rem/1.25 $technical;
  letter-spacing: .03em;
  text-align: center;
  text-transform: uppercase;
  min-height: 2.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.events-content {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-height: 0;
}

.event-group {
  position: relative;
  margin-top: 16px;
}

.event-group small {
  display: flex;
  align-items: center;
  gap: 7px;
  color: $orange;
  font-size: .72rem;
  font-weight: 700;
  font-family: $technical;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.event-group small::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(10, 10, 10, 0.08);
}

.event-group ul {
  display: grid;
  gap: 9px;
  margin: 10px 0 0;
  padding: 0;
  list-style: none;
}

.event-group li {
  color: #171717;
  font-weight: 500;
  font-family: $body;
  font-size: .86rem;
  line-height: 1.5;
  padding: 2px 0;
}

.event-group li::before {
  content: '>';
  margin-right: 6px;
  color: $orange;
  font-weight: 700;
}

.card-action {
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid rgba(10, 10, 10, 0.08);
  color: $orange;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 0.06em;
  text-align: center;
  text-transform: uppercase;
  transition: transform 350ms ease, color 350ms ease;
}

/* === HOVER INTERACTION === */
.department-card:hover,
.department-card:focus-within,
.department-card:active {
  transform: translateY(-4px);
  border-color: $orange;
  border-top-color: $orange;
  box-shadow: 0 16px 36px rgba(255, 101, 0, 0.16);

  .dept-logo-img {
    transform: scale(1.06);
  }

  .dept-logo-badge {
    border-color: $orange;
  }
}

/* MOBILE STYLES */
@media (max-width: 768px) {
  .department-card {
    padding: 0 20px 20px;
    border-radius: 16px;
  }
  .department-name {
    font-size: 1.1rem;
  }
  .event-group {
    margin-top: 12px;
  }
  .event-group small {
    font-size: 0.65rem;
  }
  .event-group ul {
    gap: 9px;
    margin-top: 8px;
  }
  .event-group li {
    font-size: 0.84rem;
    line-height: 1.4;
  }
  .card-action {
    margin-top: 16px;
    padding-top: 12px;
    font-size: 0.74rem;
  }
}
</style>
