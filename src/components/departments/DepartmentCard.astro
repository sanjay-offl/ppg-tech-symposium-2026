---
import type { Department } from '@/types';
const { department } = Astro.props as { department: Department };
---
<a href={`/departments/${department.slug}`} class="department-card-link">
  <article class="department-card">
    <div class="track-visual">
      <img src={department.image} alt={`${department.name} track`} loading="lazy" />
      <div class="track-shade"></div>
    </div>
    <h3 class="department-name">{department.abbr}</h3>
    <div class="events-content">
      <div class="event-group"><small>Technical</small><ul>{department.technicalEvents.map((event) => <li>{event}</li>)}</ul></div>
      <div class="event-group"><small>Non-Technical</small><ul>{department.nonTechnicalEvents.map((event) => <li>{event}</li>)}</ul></div>
    </div>
    <div class="card-action">View Department Track & Events ➔</div>
  </article>
</a>

<style lang="scss">
@use '../../styles/variables' as *;

.department-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
  height: 100%;
}

.department-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  overflow: hidden;
  padding: 0 24px 22px;
  border-top: 3px solid rgba(255, 101, 0, 0.5);
  border-radius: 14px;
  color: white;
  background: $card;
  transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
              background 350ms ease,
              border-color 350ms ease,
              box-shadow 350ms ease;
  cursor: pointer;
}

.track-visual {
  position: relative;
  display: grid;
  place-items: center;
  height: 140px;
  margin: 0 -24px 18px;
  overflow: hidden;
  isolation: isolate;
  background: radial-gradient(circle at center, rgba(255, 101, 0, 0.15), transparent 68%), #171719;
  transition: background 350ms ease;
}

.track-visual img {
  position: absolute;
  z-index: -2;
  width: 84%;
  height: 84%;
  object-fit: contain;
  opacity: .78;
  filter: drop-shadow(0 0 7px rgba(255, 255, 255, .2));
  transition: transform 350ms ease, opacity 350ms ease, filter 350ms ease;
}

.track-shade {
  position: absolute;
  z-index: -1;
  inset: 0;
  background: rgba(0, 0, 0, .35);
}

.department-name {
  margin: 0;
  padding: 0 4px;
  color: white;
  font: 700 1rem/1.1 $technical;
  letter-spacing: .08em;
  text-align: center;
  text-transform: uppercase;
  transition: color 350ms ease, text-shadow 350ms ease;
}

.events-content {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-height: 0;
}

.event-group {
  position: relative;
  margin-top: 14px;
}

.event-group small {
  display: flex;
  align-items: center;
  gap: 7px;
  color: rgba(255, 255, 255, .45);
  font-size: .62rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition: color 350ms ease;
}

.event-group small::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, .1);
  transition: background 350ms ease;
}

.event-group ul {
  display: grid;
  gap: 4px;
  margin: 6px 0 0;
  padding: 0;
  list-style: none;
}

.event-group li {
  color: rgba(255, 255, 255, .8);
  font-size: .78rem;
  line-height: 1.35;
}

.event-group li::before {
  content: '>';
  margin-right: 6px;
  color: rgba(255, 101, 0, 0.7);
  font-weight: 700;
  transition: color 350ms ease, text-shadow 350ms ease;
}

.card-action {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, .09);
  color: rgba(255, 255, 255, 0.5);
  font-family: $technical;
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-align: center;
  text-transform: uppercase;
  transition: transform 350ms ease, color 350ms ease, border-color 350ms ease;
}

/* === INDEPENDENT HOVER INTERACTION: ONLY HOVERED CARD TRANSITIONS TO ORANGE === */
.department-card:hover,
.department-card:focus-within,
.department-card:active {
  transform: translateY(-6px) scale(1.02);
  background: linear-gradient(160deg, #2a1f18 0%, #221813 50%, #1a1412 100%);
  border-top-color: #ff6500;
  box-shadow: 0 16px 45px rgba(255, 101, 0, 0.38), 0 0 0 1px rgba(255, 101, 0, 0.35);

  .department-name {
    color: #ff6500;
    text-shadow: 0 0 14px rgba(255, 101, 0, 0.45);
  }

  .event-group small {
    color: #ff8533;
  }

  .event-group small::after {
    background: rgba(255, 101, 0, 0.4);
  }

  .event-group li::before {
    color: #ff7a00;
    text-shadow: 0 0 8px rgba(255, 101, 0, 0.6);
  }

  .card-action {
    color: #ff6500;
    border-top-color: rgba(255, 101, 0, 0.35);
    transform: translateX(4px);
  }

  .track-visual img {
    transform: scale(1.1) rotate(-2deg);
    opacity: 1;
    filter: drop-shadow(0 0 14px rgba(255, 101, 0, 0.55));
  }

  .track-visual {
    background: radial-gradient(circle at center, rgba(255, 101, 0, 0.35), transparent 70%), #1a1412;
  }
}

/* MOBILE STYLES (Single column stacked cards on mobile/tablet) */
@media (max-width: 768px) {
  .department-card {
    padding: 0 20px 18px;
    border-radius: 14px;
    border-top-width: 3px;
  }
  .track-visual {
    height: 120px;
    margin: 0 -20px 14px;
  }
  .track-visual img {
    width: 82%;
    height: 82%;
  }
  .department-name {
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }
  .event-group {
    margin-top: 10px;
  }
  .event-group small {
    font-size: 0.62rem;
    gap: 6px;
  }
  .event-group ul {
    gap: 4px;
    margin-top: 6px;
  }
  .event-group li {
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .event-group li::before {
    margin-right: 5px;
  }
  .card-action {
    padding-top: 12px;
    font-size: 0.72rem;
  }
}
</style>
