---
import type { Department } from '@/types';
const { department } = Astro.props as { department: Department };
---
<a href={`/departments/${department.slug}`} class="department-card-link">
  <article class="department-card">
    <div class="track-visual">
      <img src={department.image} alt={`${department.name} track`} loading="lazy" />
      <div class="track-shade"></div>
    </div>
    <h3 class="department-name">{department.name}</h3>
    <div class="events-content">
      <div class="event-group"><small>Technical</small><ul>{department.technicalEvents.map((event) => <li>{event}</li>)}</ul></div>
      <div class="event-group"><small>Non-Technical</small><ul>{department.nonTechnicalEvents.map((event) => <li>{event}</li>)}</ul></div>
    </div>
    <div class="card-action">View Events Details ➔</div>
  </article>
</a>

<style lang="scss">
@use '../../styles/variables' as *;

.department-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
  height: 100%;
}

@media (max-width: 768px) {
  .department-card-link {
    width: 100%;
    max-width: 325px;
    margin-inline: auto;
  }
}

.department-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  overflow: hidden;
  padding: 0 24px 22px;
  border-radius: 14px;
  color: $black;
  background: #ffffff;
  border: 1px solid rgba(10, 10, 10, 0.08);
  border-top: 3px solid $orange;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
              background 350ms ease,
              border-color 350ms ease,
              box-shadow 350ms ease;
  cursor: pointer;
}

.track-visual {
  position: relative;
  display: grid;
  place-items: center;
  height: 140px;
  margin: 0 -24px 18px;
  overflow: hidden;
  isolation: isolate;
  background: radial-gradient(circle at center, rgba(255, 101, 0, 0.12), transparent 68%), #f9f9fb;
  transition: background 350ms ease;
}

.track-visual img {
  position: absolute;
  z-index: -2;
  width: 84%;
  height: 84%;
  object-fit: contain;
  opacity: .9;
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, .08));
  transition: transform 350ms ease, opacity 350ms ease, filter 350ms ease;
}

.track-shade {
  position: absolute;
  z-index: -1;
  inset: 0;
  background: rgba(255, 255, 255, .1);
}

.department-name {
  margin: 0;
  padding: 0 4px;
  color: $black;
  font: 700 1.02rem/1.2 $technical;
  letter-spacing: .03em;
  text-align: center;
  text-transform: uppercase;
  min-height: 2.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 350ms ease, text-shadow 350ms ease;
}

.events-content {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-height: 0;
}

.event-group {
  position: relative;
  margin-top: 14px;
}

.event-group small {
  display: flex;
  align-items: center;
  gap: 7px;
  color: $muted;
  font-size: .62rem;
  font-weight: 700;
  font-family: $technical;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition: color 350ms ease;
}

.event-group small::after {
  content: '';
  flex: 1;
  height: 1px;
  background: $line;
  transition: background 350ms ease;
}

.event-group ul {
  display: grid;
  gap: 8px;
  margin: 8px 0 0;
  padding: 0;
  list-style: none;
}

.event-group li {
  color: #333338;
  font-family: $body;
  font-size: .78rem;
  line-height: 1.45;
  padding: 1px 0;
}

.event-group li::before {
  content: '>';
  margin-right: 6px;
  color: $orange;
  font-weight: 700;
  transition: color 350ms ease, text-shadow 350ms ease;
}

.card-action {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid $line;
  color: $orange;
  font-family: $technical;
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-align: center;
  text-transform: uppercase;
  transition: transform 350ms ease, color 350ms ease, border-color 350ms ease;
}

/* === INDEPENDENT HOVER INTERACTION: MILD SUBTLE ORANGE SHADE ON HOVER === */
.department-card:hover,
.department-card:focus-within,
.department-card:active {
  transform: translateY(-6px) scale(1.02);
  background: linear-gradient(160deg, rgba(255, 101, 0, 0.06) 0%, rgba(255, 101, 0, 0.02) 60%, #ffffff 100%);
  border-color: $orange;
  border-top-color: $orange;
  box-shadow: 0 16px 36px rgba(255, 101, 0, 0.18), 0 0 0 1px $orange;

  .department-name {
    color: $orange;
  }

  .event-group small {
    color: $orange;
    font-weight: 700;
  }

  .event-group small::after {
    background: rgba(255, 101, 0, 0.3);
  }

  .event-group li::before {
    color: $orange;
  }

  .event-group li {
    color: $black;
  }

  .card-action {
    color: $orange;
    border-top-color: rgba(255, 101, 0, 0.3);
    transform: translateX(4px);
  }

  .track-visual img {
    transform: scale(1.08) rotate(-1.5deg);
    opacity: 1;
    filter: drop-shadow(0 6px 16px rgba(255, 101, 0, 0.25));
  }

  .track-visual {
    background: radial-gradient(circle at center, rgba(255, 101, 0, 0.18), transparent 70%), #fff8f5;
  }
}

/* MOBILE STYLES (Single column portrait stacked cards on mobile/tablet) */
@media (max-width: 768px) {
  .department-card {
    padding: 0 20px 20px;
    border-radius: 16px;
    border-top-width: 3px;
  }
  .track-visual {
    height: 100px;
    margin: 0 -20px 14px;
  }
  .track-visual img {
    width: 76%;
    height: 76%;
  }
  .department-name {
    font-size: 1.1rem;
    letter-spacing: 0.06em;
  }
  .event-group {
    margin-top: 12px;
  }
  .event-group small {
    font-size: 0.65rem;
    gap: 6px;
  }
  .event-group ul {
    gap: 9px;
    margin-top: 8px;
  }
  .event-group li {
    font-size: 0.84rem;
    line-height: 1.4;
    padding: 2px 0;
  }
  .event-group li::before {
    margin-right: 6px;
  }
  .card-action {
    margin-top: 16px;
    padding-top: 12px;
    font-size: 0.74rem;
  }
}
</style>
