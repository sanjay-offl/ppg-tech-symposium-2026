---
import type { Department } from '@/types';
const { department } = Astro.props as { department: Department };
---
<article class="department-card"><span class="abbr" aria-hidden="true">{department.abbr}</span><h3>{department.name}</h3><div class="event-group"><small>Technical</small><ul>{department.technicalEvents.map((event) => <li>{event}</li>)}</ul></div><div class="event-group"><small>Non-Technical</small><ul>{department.nonTechnicalEvents.map((event) => <li>{event}</li>)}</ul></div><div class="contact">{department.coordinators.map((coordinator) => <span>{coordinator}</span>)}<a href={`mailto:${department.email}`}>{department.email}</a></div></article>
<style lang="scss">@use '../../styles/variables' as *;.department-card { position: relative; overflow: hidden; padding: 28px; border-top: 3px solid $orange; border-radius: 15px; color: white; background: $card; transition: transform .25s, box-shadow .25s; }.department-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,.18); }.abbr { position: absolute; right: 12px; bottom: -8px; color: rgba(255,255,255,.04); font: 5rem $display; }.department-card h3 { position: relative; margin: 0 0 20px; color: $orange; font: 700 1rem $technical; letter-spacing: .1em; text-transform: uppercase; }.event-group { position: relative; margin-top: 16px; }.event-group small { display: flex; align-items: center; gap: 7px; color: rgba(255,255,255,.4); font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }.event-group small::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.1); }.event-group ul { display: grid; gap: 5px; margin: 8px 0 0; padding: 0; list-style: none; }.event-group li { color: rgba(255,255,255,.75); font-size: .8rem; }.event-group li::before { content: '›'; margin-right: 7px; color: $orange; }.contact { display: grid; gap: 3px; margin-top: 20px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.09); color: rgba(255,255,255,.4); font-size: .68rem; }.contact a { color: inherit; text-decoration: none; }.contact a:hover { color: white; }</style>
