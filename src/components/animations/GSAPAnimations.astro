<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);
if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const animationContext = gsap.context(() => {
    gsap.set('.navbar', { y: -90, opacity: 0 });
    gsap.set('.hero-car', { x: '-140vw', y: 48, scale: 0.82, rotation: -7, transformOrigin: '50% 80%' });
    gsap.set('.hero-content > *', { opacity: 0, y: 24 });
    gsap.set('.hero-line', { scaleX: 0, transformOrigin: 'left center' });
    gsap.set('.hero-lines i', { scaleX: 0, transformOrigin: 'left center' });

    const loadTimeline = gsap.timeline({ delay: 0.15 });
    loadTimeline
      .to('.hero-lines i', { scaleX: 1, duration: 0.45, stagger: 0.06, ease: 'power4.out' })
      .to('.hero-car', { x: 0, duration: 1.05, ease: 'power3.out' }, '-=0.3')
      .to('.hero-car', { y: -8, scale: 1.04, rotation: 1.5, duration: 0.28, ease: 'power2.out' }, '-=0.18')
      .to('.hero-car', { y: 0, scale: 1, rotation: 0, duration: 0.55, ease: 'elastic.out(1, 0.55)' }, '-=0.04')
      .to('.hero-lines i', { opacity: 0, duration: 0.35 }, '-=0.5')
      .to('.hero-content > *', { opacity: 1, y: 0, duration: 0.55, stagger: 0.08, ease: 'power3.out' }, '-=0.2')
      .to('.hero-line', { scaleX: 1, duration: 0.65, ease: 'power2.out' }, '-=0.25')
      .to('.navbar', { y: 0, opacity: 1, duration: 0.65, ease: 'back.out(1.5)' }, '-=0.35');

    gsap.to('.hero-car img', {
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1.2 },
      y: 80,
      x: -20,
      ease: 'none'
    });

    gsap.from('.reveal', { scrollTrigger: { trigger: '.reveal', start: 'top 86%' }, opacity: 0, y: 28, duration: .7, ease: 'power3.out' });
    gsap.utils.toArray<HTMLElement>('.department-card, .event-card').forEach((card) => gsap.from(card, { scrollTrigger: { trigger: card, start: 'top 90%' }, opacity: 0, y: 24, duration: .55, ease: 'power2.out' }));
  });

  document.addEventListener('astro:before-preparation', () => {
    animationContext.revert();
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
  }, { once: true });
}
</script>
