---
/* DeptScrollLineCanvas.astro - Splashscreen line motion with user scroll interaction */
---
<canvas id="dept-scroll-line-canvas" class="dept-scroll-line-canvas" aria-hidden="true"></canvas>

<style lang="scss">
.dept-scroll-line-canvas {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  z-index: 0;
  opacity: 0.95;
  border: none !important;
  outline: none !important;
  box-shadow: none !important;
  margin: 0;
  padding: 0;
  clip-path: inset(0);
}
</style>

<script>
function initDeptScrollLineCanvas() {
  const canvas = document.getElementById('dept-scroll-line-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const parent = canvas.parentElement;
  if (!parent) return;

  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let animFrameId: number | null = null;
  let scrollY = window.scrollY;
  let targetScrollVelocity = 0;
  let currentScrollVelocity = 0;

  function resize() {
    if (!canvas || !parent) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = parent.clientWidth * dpr;
    canvas.height = parent.clientHeight * dpr;
    ctx?.scale(dpr, dpr);
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  // Handle scroll-driven motion boost
  const onScroll = () => {
    const newScrollY = window.scrollY;
    const delta = newScrollY - scrollY;
    scrollY = newScrollY;
    targetScrollVelocity += delta * 0.45;
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // Generate splashscreen-style streak rays with equal left & right motion
  interface Ray {
    x: number;
    y: number;
    length: number;
    angle: number;
    speed: number;
    width: number;
    color: string;
    opacity: number;
    glow: boolean;
    dir: number; // 1 for left-to-right, -1 for right-to-left
  }

  const rays: Ray[] = [];
  const parentWidth = parent.clientWidth;
  const parentHeight = parent.clientHeight;
  const isMobile = window.innerWidth <= 768;

  // Higher ray density specifically tuned for mobile view
  const baseCount = isMobile ? 125 : 90;
  const heightFactor = Math.floor(parentHeight / 500);
  const rayCount = Math.min(185, Math.max(baseCount, baseCount + heightFactor * 15));

  // Moderately bright and clear color palette for white background
  const colors = [
    '#FF6500',                   // Vibrant Brand Orange
    'rgba(255, 101, 0, 0.68)',  // Bright translucent orange
    'rgba(255, 133, 51, 0.58)', // Bright accent orange
    'rgba(20, 20, 25, 0.16)',   // Subtle dark contrast streak line
    'rgba(255, 101, 0, 0.38)'   // Luminous translucent orange
  ];

  function spawnRay(ray: Ray, width: number, height: number, initial: boolean) {
    if (initial) {
      // Uniformly scatter across full background height and width on startup
      ray.x = Math.random() * (width + 400) - 200;
      ray.y = Math.random() * (height + 400) - 200;
    } else {
      // Re-spawn along full height and width boundaries
      const spawnFromSide = Math.random() > 0.4;
      if (ray.dir === 1) {
        // Left-to-Right ray entering
        if (spawnFromSide) {
          ray.x = -ray.length - Math.random() * 80;
          ray.y = Math.random() * (height + 200) - 100;
        } else {
          ray.x = Math.random() * (width + 200) - 200;
          ray.y = height + ray.length + Math.random() * 80;
        }
      } else {
        // Right-to-Left ray entering
        if (spawnFromSide) {
          ray.x = width + ray.length + Math.random() * 80;
          ray.y = Math.random() * (height + 200) - 100;
        } else {
          ray.x = Math.random() * (width + 200) - 100;
          ray.y = height + ray.length + Math.random() * 80;
        }
      }
    }
  }

  for (let i = 0; i < rayCount; i++) {
    const isLeftToRight = i % 2 === 0; // Exactly 50% left-to-right, 50% right-to-left
    const baseAngle = isLeftToRight ? -Math.PI * 0.26 : -Math.PI * 0.74;
    const rayAngle = baseAngle + (Math.random() - 0.5) * 0.14;

    const newRay: Ray = {
      x: 0,
      y: 0,
      length: isMobile ? (Math.random() * 190 + 95) : (Math.random() * 250 + 125),
      angle: rayAngle,
      speed: Math.random() * 1.7 + 0.75,
      width: isMobile ? (Math.random() * 2.0 + 0.9) : (Math.random() * 1.8 + 0.9),
      color: colors[Math.floor(Math.random() * colors.length)],
      opacity: isMobile ? (Math.random() * 0.4 + 0.28) : (Math.random() * 0.4 + 0.25),
      glow: Math.random() > 0.45,
      dir: isLeftToRight ? 1 : -1
    };

    spawnRay(newRay, parentWidth, parentHeight, true);
    rays.push(newRay);
  }

  function render() {
    if (!ctx || !canvas || !parent) return;
    const width = parent.clientWidth;
    const height = parent.clientHeight;

    ctx.clearRect(0, 0, width, height);

    // Strictly clip 2px inside canvas boundary to eliminate any edge border line artifacts
    ctx.save();
    ctx.beginPath();
    ctx.rect(2, 2, Math.max(0, width - 4), Math.max(0, height - 4));
    ctx.clip();

    // Smooth physics interpolation for scroll velocity
    currentScrollVelocity += (targetScrollVelocity - currentScrollVelocity) * 0.1;
    targetScrollVelocity *= 0.88; // decay impulse

    rays.forEach((ray) => {
      ctx.save();
      ctx.strokeStyle = ray.color;
      ctx.lineWidth = ray.width;
      ctx.globalAlpha = ray.opacity;
      ctx.lineCap = 'round';

      if (ray.glow) {
        ctx.shadowColor = '#FF6500';
        ctx.shadowBlur = 4;
      }

      // Calculate line segment start and end points
      const endX = ray.x + Math.cos(ray.angle) * ray.length;
      const endY = ray.y + Math.sin(ray.angle) * ray.length;

      ctx.beginPath();
      ctx.moveTo(ray.x, ray.y);
      ctx.lineTo(endX, endY);
      ctx.stroke();

      // Draw subtle sparkling head node on select rays
      if (ray.glow && ray.width > 1.4) {
        ctx.fillStyle = '#FF6500';
        ctx.beginPath();
        ctx.arc(endX, endY, ray.width * 0.8, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();

      // Movement vector combining ambient drift + user scroll velocity
      const movementSpeed = ray.speed + Math.abs(currentScrollVelocity) * 0.28;
      ray.x += Math.cos(ray.angle) * movementSpeed;
      ray.y += Math.sin(ray.angle) * movementSpeed;

      // Wrap around bounds seamlessly across full canvas height & width
      if (ray.dir === 1) {
        // Left-to-Right rays check out of bounds
        if (ray.y < -ray.length || ray.x > width + ray.length || ray.y > height + ray.length * 2) {
          spawnRay(ray, width, height, false);
        }
      } else {
        // Right-to-Left rays check out of bounds
        if (ray.y < -ray.length || ray.x < -ray.length || ray.y > height + ray.length * 2) {
          spawnRay(ray, width, height, false);
        }
      }
    });

    // Erase ray movement strictly in the background of heading box (.dept-header-box)
    const headerBoxes = document.querySelectorAll('.dept-header-box');
    headerBoxes.forEach((headerBox) => {
      const pRect = parent.getBoundingClientRect();
      const hRect = headerBox.getBoundingClientRect();
      if (hRect.width > 0 && hRect.height > 0) {
        const padX = 14;
        const padY = 14;
        const boxLeft = hRect.left - pRect.left - padX;
        const boxTop = hRect.top - pRect.top - padY;
        const boxWidth = hRect.width + padX * 2;
        const boxHeight = hRect.height + padY * 2;

        ctx.clearRect(boxLeft, boxTop, boxWidth, boxHeight);
      }
    });

    ctx.restore();

    animFrameId = requestAnimationFrame(render);
  }

  render();

  document.addEventListener('astro:before-preparation', () => {
    if (animFrameId !== null) cancelAnimationFrame(animFrameId);
    window.removeEventListener('resize', resize);
    window.removeEventListener('scroll', onScroll);
  }, { once: true });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initDeptScrollLineCanvas);
} else {
  initDeptScrollLineCanvas();
}
</script>
