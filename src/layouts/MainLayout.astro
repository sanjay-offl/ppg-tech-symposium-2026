---
import '../styles/global.scss';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import LenisScroll from '@/components/animations/LenisScroll.astro';
import GSAPAnimations from '@/components/animations/GSAPAnimations.astro';
import IntroOverlay from '@/components/common/IntroOverlay.astro';

const SITE_URL = 'https://viyugam2k26.vercel.app';

const canonicalURL = new URL(
  Astro.url.pathname,
  SITE_URL
).href;

const ogImage = `${SITE_URL}/METATAG.png`;

const {
  title = 'VIYUGAM 2K26 | National Level Technical Symposium | PPG Institute of Technology, Coimbatore',
  description = 'VIYUGAM 2K26 — National Level Technical Symposium at PPG Institute of Technology, Coimbatore on 25 September 2026.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head prefix="og: https://ogp.me/ns#">

    <!-- ─────────────────────────────────────
         BASE TAGS
    ───────────────────────────────────────── -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- ─────────────────────────────────────
         PAGE TITLE
    ───────────────────────────────────────── -->
    <title>{title}</title>

    <!-- ─────────────────────────────────────
         CANONICAL
    ───────────────────────────────────────── -->
    <link rel="canonical" href={canonicalURL} />

    <!-- ─────────────────────────────────────
         SEO — GOOGLE / BING
    ───────────────────────────────────────── -->
    <meta name="description" content={description} />

    <meta name="keywords" content="VIYUGAM, VIYUGAM 2K26, VIYUGAM2K26, Technical Symposium 2026, PPG Institute of Technology, PPGIT Coimbatore, National Level Symposium, Tamil Nadu Tech Fest, Engineering Fest Coimbatore, College Symposium 2026, Student Events Tamil Nadu, CSE Symposium, AI Events, Cash Prize Fest India" />

    <meta name="author" content="PPG Institute of Technology, Coimbatore" />

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <meta name="googlebot" content="index, follow" />

    <meta name="revisit-after" content="7 days" />

    <meta name="language" content="English" />

    <meta name="geo.region" content="IN-TN" />

    <meta name="geo.placename" content="Coimbatore, Tamil Nadu, India" />

    <!-- ─────────────────────────────────────
         OPEN GRAPH
         WhatsApp · Facebook · LinkedIn
         Discord · Telegram · Slack · Signal
    ───────────────────────────────────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VIYUGAM 2K26" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="VIYUGAM 2K26 | National Level Technical Symposium" />
    <meta property="og:description" content="VIYUGAM 2K26 — National Level Technical Symposium at PPG Institute of Technology, Coimbatore on 25 September 2026." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VIYUGAM 2K26 — National Level Technical Symposium" />
    <meta property="og:locale" content="en_IN" />
    <meta name="image" content={ogImage} />
    <meta itemprop="image" content={ogImage} />
    <link rel="image_src" href={ogImage} />

    <!-- ─────────────────────────────────────
         TWITTER / X CARD
    ───────────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ppgit_official" />
    <meta name="twitter:title" content="VIYUGAM 2K26 | National Level Technical Symposium" />
    <meta name="twitter:description" content="National Level Technical Symposium at PPG Institute of Technology, Coimbatore." />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="VIYUGAM 2K26 — National Level Technical Symposium" />

    <!-- ─────────────────────────────────────
         THEME COLOR
         Discord embed border · Android Chrome
    ───────────────────────────────────────── -->
    <meta name="theme-color" content="#f97316" />
    <meta name="msapplication-TileColor" content="#f97316" />

    <!-- ─────────────────────────────────────
         FAVICON
    ───────────────────────────────────────── -->
    <link rel="icon" type="image/png" href="/FAVICON.png" />
    <link rel="shortcut icon" href="/FAVICON.png" />
    <link rel="apple-touch-icon" href="/FAVICON.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- ─────────────────────────────────────
         PRELOAD OG IMAGE (faster crawl)
    ───────────────────────────────────────── -->
    <link rel="preload" as="image" href={ogImage} />

    <!-- ─────────────────────────────────────
         GOOGLE FONTS
    ───────────────────────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- ─────────────────────────────────────
         GOOGLE STRUCTURED DATA — JSON-LD
         Event rich card in Google search
    ───────────────────────────────────────── -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "VIYUGAM 2K26",
      "alternateName": "VIYUGAM 2026",
      "description": "National Level Technical Symposium at PPG Institute of Technology, Coimbatore. 40+ Events across 8 Engineering Departments with Cash Prizes and Workshops on 25 September 2026.",
      "image": ogImage,
      "startDate": "2026-09-25T09:00:00+05:30",
      "endDate": "2026-09-25T18:00:00+05:30",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": "PPG Institute of Technology",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Karumathampatti",
          "addressLocality": "Coimbatore",
          "addressRegion": "Tamil Nadu",
          "postalCode": "641659",
          "addressCountry": "IN"
        }
      },
      "organizer": {
        "@type": "Organization",
        "name": "PPG Institute of Technology",
        "url": "https://viyugam2k26.vercel.app"
      },
      "url": "https://viyugam2k26.vercel.app",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR",
        "availability": "https://schema.org/InStock",
        "url": "https://viyugam2k26.vercel.app/register",
        "validFrom": "2026-09-01T00:00:00+05:30"
      }
    }
    </script>

  </head>
  <body>
    <IntroOverlay />
    <Navbar />
    <main><slot /></main>
    <Footer />
    <LenisScroll />
    <GSAPAnimations />
    <script>
      function setupGlobalPhoneHandler() {
        const phoneRegex = /(?:\+?91[\s-]?)?[6-9]\d{4}[\s-]?\d{5}|(?:\+?91[\s-]?)?[6-9]\d{9}/;

        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (!target) return;

          // If clicked inside an existing link/button/input, let default handling work
          if (target.closest('a') || target.closest('button') || target.closest('input')) return;

          const text = (target.textContent || '').trim();
          // If the element text is brief and contains a phone number
          if (text.length > 0 && text.length < 60) {
            const match = text.match(phoneRegex);
            if (match) {
              const rawDigits = match[0].replace(/[^\d+]/g, '');
              const cleanPhone = rawDigits.startsWith('+') ? rawDigits : (rawDigits.length === 10 ? `+91${rawDigits}` : rawDigits);
              window.location.href = `tel:${cleanPhone}`;
            }
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupGlobalPhoneHandler);
      } else {
        setupGlobalPhoneHandler();
      }
      document.addEventListener('astro:page-load', setupGlobalPhoneHandler);
    </script>
  </body>
</html>
